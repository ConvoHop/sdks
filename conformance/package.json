{
  "name": "@convohop/conformance",
  "version": "0.0.0",
  "private": true,
  "description": "Cross-language conformance runner, deterministic mock target and TypeScript reference driver. Never published.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build drivers/ts ../packages/react ../packages/react-native",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "test:browser": "node --test --test-concurrency=1 \"browser/*.test.mjs\""
  },
  "devDependencies": {
    "@convohop/client": "*",
    "@convohop/react": "*",
    "@convohop/react-native": "*",
    "@convohop/server": "*",
    "@types/node": "^22.20.5",
    "graphql": "17.0.2",
    "playwright": "1.64.0",
    "react": "^18.3.1 || ^19.3.0",
    "react-test-renderer": "^18.3.1 || ^19.3.0",
    "typescript": "^7.0.2"
  }
}
