{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConvoHop SDK intermediate representation",
  "description": "Language-neutral model of the GraphQL planes, the generated operation documents and the operation annotations. Generated by `npm run generate:graphql` into schema/ir.json; every SDK emitter reads only this document.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "api", "sources", "transport", "planes", "credentials", "scopes", "conditions", "idempotency",
    "pagination", "errors", "realtime", "operations", "types"
  ],
  "properties": {
    "$schema": { "const": "./ir.schema.json" },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "summary"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "summary": { "$ref": "#/$defs/summary" }
      }
    },
    "sources": {
      "description": "Repository-relative inputs the IR was built from.",
      "type": "object",
      "additionalProperties": false,
      "required": ["graphql", "annotations"],
      "properties": {
        "graphql": { "type": "array", "items": { "$ref": "#/$defs/path" }, "uniqueItems": true, "minItems": 1 },
        "annotations": { "$ref": "#/$defs/path" }
      }
    },
    "transport": { "$ref": "#/$defs/transport" },
    "planes": {
      "description": "GraphQL planes in generation order.",
      "type": "array",
      "items": { "$ref": "#/$defs/plane" },
      "minItems": 1
    },
    "credentials": { "type": "array", "items": { "$ref": "#/$defs/credential" }, "minItems": 1 },
    "scopes": { "description": "Backend-key scopes; name is the exact wire string.", "type": "array", "items": { "$ref": "#/$defs/namedSummary" } },
    "conditions": {
      "description": "Resource-level conditions the authority evaluates in addition to the credential and scopes.",
      "type": "array",
      "items": { "$ref": "#/$defs/namedSummary" }
    },
    "idempotency": { "type": "array", "items": { "$ref": "#/$defs/idempotencyMode" }, "minItems": 5, "maxItems": 5 },
    "pagination": { "type": "array", "items": { "$ref": "#/$defs/paginationStyle" }, "minItems": 5, "maxItems": 5 },
    "errors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codes", "sets"],
      "properties": {
        "codes": { "type": "array", "items": { "$ref": "#/$defs/errorCodeDefinition" }, "minItems": 1 },
        "sets": { "type": "array", "items": { "$ref": "#/$defs/errorSet" } }
      }
    },
    "realtime": { "$ref": "#/$defs/realtime" },
    "operations": {
      "description": "Every GraphQL root field in generation order: plane order, then query, mutation and subscription, then schema order.",
      "type": "array",
      "items": { "$ref": "#/$defs/operation" }
    },
    "types": {
      "description": "Every named type of every plane except root and introspection types, in graphql-js type-map order of the first plane that defines it. Same-named types are identical across planes.",
      "type": "array",
      "items": { "$ref": "#/$defs/type" }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
    "typeName": { "type": "string", "pattern": "^[_A-Za-z][_0-9A-Za-z]*$" },
    "fieldName": { "type": "string", "pattern": "^[_A-Za-z][_0-9A-Za-z]*$" },
    "operationId": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*\\.[_A-Za-z][_0-9A-Za-z]*$" },
    "errorCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "eventType": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*(\\.[a-z][A-Za-z0-9]*)+$" },
    "path": { "type": "string", "pattern": "^[^/\\\\].*[^/\\\\]$" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 400, "pattern": "^\\S(.*\\S)?$" },
    "text": { "description": "GraphQL description text, verbatim.", "type": "string", "minLength": 1 },
    "fieldList": { "type": "array", "items": { "$ref": "#/$defs/fieldName" }, "uniqueItems": true },
    "operationList": { "type": "array", "items": { "$ref": "#/$defs/operationId" }, "uniqueItems": true, "minItems": 1 },
    "namedSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "summary"],
      "properties": { "name": { "$ref": "#/$defs/identifier" }, "summary": { "$ref": "#/$defs/summary" } }
    },
    "deprecation": {
      "description": "Present when the schema element is @deprecated. reason is present only when the schema states one.",
      "type": "object",
      "additionalProperties": false,
      "properties": { "reason": { "type": "string" } }
    },
    "typeRef": {
      "description": "A GraphQL type reference. Named references point at an entry of `types`.",
      "type": "object",
      "required": ["kind", "nullable"],
      "properties": { "kind": { "enum": ["list", "scalar", "enum", "object", "input"] } },
      "if": { "properties": { "kind": { "const": "list" } } },
      "then": {
        "additionalProperties": false,
        "required": ["ofType"],
        "properties": { "kind": true, "nullable": { "type": "boolean" }, "ofType": { "$ref": "#/$defs/typeRef" } }
      },
      "else": {
        "additionalProperties": false,
        "required": ["name"],
        "properties": { "kind": true, "name": { "$ref": "#/$defs/typeName" }, "nullable": { "type": "boolean" } }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "http", "websocket", "errors"],
      "properties": {
        "path": { "type": "string", "pattern": "^/[a-z][a-z0-9/-]*$" },
        "http": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "contentType", "accept", "body", "maxDocumentBytes"],
          "properties": {
            "method": { "const": "POST" },
            "contentType": { "const": "application/json" },
            "accept": { "const": "application/json" },
            "body": { "type": "array", "items": { "enum": ["query", "operationName", "variables"] }, "uniqueItems": true, "minItems": 1 },
            "maxDocumentBytes": { "type": "integer", "minimum": 1 }
          }
        },
        "websocket": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subprotocol"],
          "properties": { "subprotocol": { "const": "graphql-transport-ws" } }
        },
        "errors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "extensions"],
          "properties": {
            "summary": { "$ref": "#/$defs/summary" },
            "extensions": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": { "$ref": "#/$defs/fieldName" },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "summary"],
                "properties": {
                  "type": { "enum": ["string", "integer", "boolean"] },
                  "summary": { "$ref": "#/$defs/summary" },
                  "values": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true, "minItems": 1 }
                }
              }
            }
          }
        }
      }
    },
    "plane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "schema", "summary", "context", "resolveOperation"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "schema": { "$ref": "#/$defs/path" },
        "summary": { "$ref": "#/$defs/summary" },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["argument", "type", "rules"],
          "properties": {
            "argument": { "$ref": "#/$defs/fieldName" },
            "type": { "$ref": "#/$defs/typeName" },
            "rules": { "type": "array", "items": { "$ref": "#/$defs/contextRule" } }
          }
        },
        "resolveOperation": { "$ref": "#/$defs/operationId" }
      }
    },
    "contextRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "use", "summary"],
      "properties": {
        "fields": { "$ref": "#/$defs/fieldList", "minItems": 1 },
        "use": { "enum": ["required", "forbidden"] },
        "only": { "$ref": "#/$defs/operationList" },
        "except": { "$ref": "#/$defs/operationList" },
        "summary": { "$ref": "#/$defs/summary" }
      },
      "not": { "required": ["only", "except"] }
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "summary", "runtime", "carrier", "scoped"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "summary": { "$ref": "#/$defs/summary" },
        "runtime": { "description": "client: safe for client SDKs. server: trusted server runtimes only.", "enum": ["client", "server"] },
        "carrier": { "description": "bearer: Authorization header. context: a request-context field.", "enum": ["bearer", "context"] },
        "contextField": { "$ref": "#/$defs/fieldName" },
        "scoped": { "type": "boolean" }
      },
      "if": { "properties": { "carrier": { "const": "context" } } },
      "then": { "required": ["contextField"] },
      "else": { "not": { "required": ["contextField"] } }
    },
    "idempotencyMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "summary", "retry", "resolvable"],
      "properties": {
        "name": { "enum": ["safe", "idempotent", "singleUse", "permitBound", "ephemeral"] },
        "summary": { "$ref": "#/$defs/summary" },
        "retry": { "enum": ["repeat", "sameRequest", "none"] },
        "resolvable": { "type": "boolean" },
        "retryBudget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxAttempts", "windowMs"],
          "properties": {
            "maxAttempts": { "type": "integer", "minimum": 1 },
            "windowMs": { "type": "integer", "minimum": 1 }
          }
        }
      },
      "if": { "properties": { "retry": { "const": "sameRequest" } } },
      "then": { "required": ["retryBudget"] },
      "else": { "not": { "required": ["retryBudget"] } }
    },
    "paginationStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "summary", "order", "cursorInput", "pageFields"],
      "properties": {
        "name": { "enum": ["none", "cursor", "sequence", "replay", "bounded"] },
        "summary": { "$ref": "#/$defs/summary" },
        "order": { "enum": ["none", "server", "ascending", "descending"] },
        "cursorInput": { "type": "boolean" },
        "pageFields": { "$ref": "#/$defs/fieldList" }
      }
    },
    "errorCodeDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "summary", "origin", "retryable"],
      "properties": {
        "name": { "$ref": "#/$defs/errorCode" },
        "summary": { "$ref": "#/$defs/summary" },
        "origin": { "enum": ["server", "sdk", "both"] },
        "status": { "type": "integer", "minimum": 400, "maximum": 599 },
        "retryable": { "type": "boolean" }
      }
    },
    "errorSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "summary", "codes"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "summary": { "$ref": "#/$defs/summary" },
        "codes": { "type": "array", "items": { "$ref": "#/$defs/errorCode" }, "uniqueItems": true }
      }
    },
    "realtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope", "channels", "events"],
      "properties": {
        "envelope": {
          "description": "The object type every realtime page item uses. `type` names an entry of `types`.",
          "type": "object",
          "additionalProperties": false,
          "required": ["plane", "type", "discriminator", "payload", "payloadType", "subject", "subjectType", "unknownTypes"],
          "properties": {
            "plane": { "$ref": "#/$defs/identifier" },
            "type": { "$ref": "#/$defs/typeName" },
            "discriminator": { "description": "String field holding the event type.", "$ref": "#/$defs/fieldName" },
            "payload": { "$ref": "#/$defs/fieldName" },
            "payloadType": { "$ref": "#/$defs/typeName" },
            "subject": { "$ref": "#/$defs/fieldName" },
            "subjectType": { "$ref": "#/$defs/typeName" },
            "unknownTypes": { "const": "deliverAsUnknown" }
          }
        },
        "channels": { "type": "array", "items": { "$ref": "#/$defs/channel" } },
        "events": { "type": "array", "items": { "$ref": "#/$defs/event" } }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "summary", "subscription", "replay", "pageType", "endpoint", "connectionInit", "ordering", "limits", "reconnect"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "summary": { "$ref": "#/$defs/summary" },
        "subscription": { "$ref": "#/$defs/operationId" },
        "replay": { "$ref": "#/$defs/operationId" },
        "pageType": { "description": "Page type both the subscription and the replay query deliver.", "$ref": "#/$defs/typeName" },
        "endpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "resultField"],
          "properties": {
            "operation": { "$ref": "#/$defs/operationId" },
            "resultField": { "$ref": "#/$defs/fieldName" }
          }
        },
        "connectionInit": { "$ref": "#/$defs/fieldList" },
        "ordering": { "$ref": "#/$defs/summary" },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxFrameBytes", "maxPendingPages", "subscribeLimit", "replayLimit"],
          "properties": {
            "maxFrameBytes": { "type": "integer", "minimum": 1 },
            "maxPendingPages": { "type": "integer", "minimum": 1 },
            "subscribeLimit": { "type": "integer", "minimum": 1 },
            "replayLimit": { "type": "integer", "minimum": 1 }
          }
        },
        "reconnect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseDelayMs", "maxDelayMs", "jitterMs", "terminalCloseCodes"],
          "properties": {
            "baseDelayMs": { "type": "integer", "minimum": 1 },
            "maxDelayMs": { "type": "integer", "minimum": 1 },
            "jitterMs": { "type": "integer", "minimum": 0 },
            "terminalCloseCodes": { "type": "array", "items": { "type": "integer", "minimum": 1000, "maximum": 4999 }, "uniqueItems": true }
          }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "summary", "subject", "payload", "emittedBy"],
      "properties": {
        "type": { "$ref": "#/$defs/eventType" },
        "summary": { "$ref": "#/$defs/summary" },
        "subject": { "description": "Expected kind of the envelope subject.", "$ref": "#/$defs/identifier" },
        "payload": {
          "description": "Fields of the envelope payload type that this event sets (required) or may set (optional).",
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "optional"],
          "properties": {
            "required": { "$ref": "#/$defs/fieldList" },
            "optional": { "$ref": "#/$defs/fieldList" }
          }
        },
        "emittedBy": { "description": "Operations documented to emit the event (best effort).", "type": "array", "items": { "$ref": "#/$defs/operationId" }, "uniqueItems": true }
      }
    },
    "authRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credential"],
      "properties": {
        "credential": { "$ref": "#/$defs/identifier" },
        "scopes": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true, "minItems": 1 },
        "condition": { "$ref": "#/$defs/identifier" }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "plane", "kind", "field", "operationName", "summary", "layer", "auth", "arguments", "context", "input", "result",
        "document", "idempotency", "pagination", "realtime", "errors"
      ],
      "properties": {
        "id": { "description": "`<plane>.<field>`.", "$ref": "#/$defs/operationId" },
        "plane": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["query", "mutation", "subscription"] },
        "field": { "$ref": "#/$defs/fieldName" },
        "operationName": { "description": "GraphQL operation name sent on the wire.", "$ref": "#/$defs/typeName" },
        "summary": { "$ref": "#/$defs/summary" },
        "description": { "$ref": "#/$defs/text" },
        "deprecated": { "$ref": "#/$defs/deprecation" },
        "layer": { "description": "client: client SDKs only. server: server SDKs only. both: every SDK.", "enum": ["client", "server", "both"] },
        "auth": {
          "description": "Alternative ways to authorize the operation; any one entry suffices.",
          "type": "array",
          "items": { "$ref": "#/$defs/authRequirement" },
          "minItems": 1
        },
        "arguments": {
          "description": "Root-field arguments in schema order; also the variable order of the document.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "role", "type"],
            "properties": {
              "name": { "$ref": "#/$defs/fieldName" },
              "role": { "enum": ["context", "input"] },
              "type": { "$ref": "#/$defs/typeRef" }
            }
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["argument", "type", "fields"],
          "properties": {
            "argument": { "$ref": "#/$defs/fieldName" },
            "type": { "$ref": "#/$defs/typeName" },
            "fields": {
              "description": "Effective use of every context field for this operation, in schema order.",
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "use"],
                "properties": {
                  "name": { "$ref": "#/$defs/fieldName" },
                  "use": { "enum": ["required", "optional", "forbidden"] }
                }
              }
            }
          }
        },
        "input": {
          "description": "The input object argument, or null when the operation takes none.",
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["argument", "type", "required"],
          "properties": {
            "argument": { "const": "input" },
            "type": { "$ref": "#/$defs/typeName" },
            "required": { "type": "boolean" }
          }
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "$ref": "#/$defs/typeRef" } }
        },
        "document": {
          "description": "The executable document. It selects every field of every reachable object type, so result models are the object types in `types`.",
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "bytes", "selectedFields", "depth"],
          "properties": {
            "text": { "type": "string", "minLength": 1 },
            "bytes": { "description": "UTF-8 length of text.", "type": "integer", "minimum": 1 },
            "selectedFields": { "type": "integer", "minimum": 1 },
            "depth": { "type": "integer", "minimum": 0 }
          }
        },
        "idempotency": { "enum": ["safe", "idempotent", "singleUse", "permitBound", "ephemeral"] },
        "destructive": {
          "description": "Present only on mutations that delete, revoke, remove, disable or end something, or retire a secret. Absent means the operation is not destructive.",
          "const": true
        },
        "pagination": {
          "type": "object",
          "additionalProperties": false,
          "required": ["style"],
          "properties": {
            "style": { "enum": ["none", "cursor", "sequence", "replay", "bounded"] },
            "limitField": { "description": "Field of the input type holding the page size.", "$ref": "#/$defs/fieldName" },
            "cursorField": { "description": "Field of the input type holding the cursor.", "$ref": "#/$defs/fieldName" },
            "pagePath": { "description": "Field path from the result to the page object; [] when the result is the page.", "$ref": "#/$defs/fieldList" },
            "pageType": { "$ref": "#/$defs/typeName" },
            "itemType": { "$ref": "#/$defs/typeName" }
          },
          "if": { "properties": { "style": { "const": "none" } } },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["limitField"] }, { "required": ["cursorField"] }, { "required": ["pagePath"] }, { "required": ["pageType"] },
                { "required": ["itemType"] }
              ]
            }
          },
          "else": {
            "required": ["pagePath", "pageType", "itemType"],
            "if": { "properties": { "style": { "const": "bounded" } } },
            "then": { "not": { "anyOf": [{ "required": ["limitField"] }, { "required": ["cursorField"] }] } },
            "else": { "required": ["limitField", "cursorField"] }
          }
        },
        "realtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["none", "subscription"] },
            "channel": { "$ref": "#/$defs/identifier" },
            "emits": { "type": "array", "items": { "$ref": "#/$defs/eventType" }, "uniqueItems": true, "minItems": 1 }
          },
          "if": { "properties": { "mode": { "const": "subscription" } } },
          "then": { "required": ["channel"], "not": { "required": ["emits"] } },
          "else": { "not": { "required": ["channel"] } }
        },
        "longRunning": {
          "description": "Poll `poll` with input.operationId taken from result.<refField>.operationId until the work completes.",
          "type": "object",
          "additionalProperties": false,
          "required": ["poll", "refField"],
          "properties": {
            "poll": { "$ref": "#/$defs/operationId" },
            "refField": { "$ref": "#/$defs/fieldName" }
          }
        },
        "errors": {
          "description": "Documented, non-exhaustive error codes. codes already includes every code of the referenced sets.",
          "type": "object",
          "additionalProperties": false,
          "required": ["sets", "codes"],
          "properties": {
            "sets": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "uniqueItems": true },
            "codes": { "type": "array", "items": { "$ref": "#/$defs/errorCode" }, "uniqueItems": true }
          }
        }
      }
    },
    "type": {
      "type": "object",
      "required": ["name", "kind", "planes"],
      "properties": { "kind": { "enum": ["scalar", "enum", "object", "input"] } },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "scalar" } } }, "then": { "$ref": "#/$defs/scalarType" } },
        { "if": { "properties": { "kind": { "const": "enum" } } }, "then": { "$ref": "#/$defs/enumType" } },
        { "if": { "properties": { "kind": { "const": "object" } } }, "then": { "$ref": "#/$defs/objectType" } },
        { "if": { "properties": { "kind": { "const": "input" } } }, "then": { "$ref": "#/$defs/inputType" } }
      ]
    },
    "typePlanes": {
      "description": "Planes that define the type, in plane order.",
      "type": "array",
      "items": { "$ref": "#/$defs/identifier" },
      "uniqueItems": true,
      "minItems": 1
    },
    "scalarType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "planes", "builtIn", "representation"],
      "properties": {
        "name": { "$ref": "#/$defs/typeName" },
        "kind": { "const": "scalar" },
        "planes": { "$ref": "#/$defs/typePlanes" },
        "description": { "$ref": "#/$defs/text" },
        "builtIn": { "description": "True for the GraphQL built-in scalars (String, Int, Float, Boolean, ID).", "type": "boolean" },
        "representation": {
          "description": "JSON representation on the wire. ID is a string on output; inputs also accept integers.",
          "enum": ["string", "integer", "number", "boolean", "object"]
        },
        "summary": { "$ref": "#/$defs/summary" },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "pattern": { "description": "ECMAScript/PCRE-compatible regular expression the whole value matches.", "type": "string", "minLength": 1 },
            "disallowed": { "type": "array", "items": { "type": "string" }, "uniqueItems": true, "minItems": 1 },
            "minimum": { "type": "integer" },
            "maximum": { "type": "integer" },
            "maximumDecimal": { "description": "Largest value of a decimal-string scalar, as a decimal string.", "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
            "maxCanonicalJsonBytes": { "type": "integer", "minimum": 1 },
            "requiredStringProperties": { "$ref": "#/$defs/fieldList" }
          }
        }
      },
      "if": { "properties": { "builtIn": { "const": false } } },
      "then": { "required": ["summary"] },
      "else": { "not": { "anyOf": [{ "required": ["summary"] }, { "required": ["constraints"] }] } }
    },
    "enumType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "planes", "values"],
      "properties": {
        "name": { "$ref": "#/$defs/typeName" },
        "kind": { "const": "enum" },
        "planes": { "$ref": "#/$defs/typePlanes" },
        "description": { "$ref": "#/$defs/text" },
        "values": {
          "description": "Values in schema order.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "$ref": "#/$defs/fieldName" },
              "description": { "$ref": "#/$defs/text" },
              "deprecated": { "$ref": "#/$defs/deprecation" }
            }
          }
        }
      }
    },
    "objectType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "planes", "fields"],
      "properties": {
        "name": { "$ref": "#/$defs/typeName" },
        "kind": { "const": "object" },
        "planes": { "$ref": "#/$defs/typePlanes" },
        "description": { "$ref": "#/$defs/text" },
        "fields": {
          "description": "Fields in schema order.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type"],
            "properties": {
              "name": { "$ref": "#/$defs/fieldName" },
              "description": { "$ref": "#/$defs/text" },
              "deprecated": { "$ref": "#/$defs/deprecation" },
              "type": { "$ref": "#/$defs/typeRef" }
            }
          }
        }
      }
    },
    "inputType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "planes", "fields"],
      "properties": {
        "name": { "$ref": "#/$defs/typeName" },
        "kind": { "const": "input" },
        "planes": { "$ref": "#/$defs/typePlanes" },
        "description": { "$ref": "#/$defs/text" },
        "fields": {
          "description": "Fields in schema order.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type"],
            "properties": {
              "name": { "$ref": "#/$defs/fieldName" },
              "description": { "$ref": "#/$defs/text" },
              "deprecated": { "$ref": "#/$defs/deprecation" },
              "type": { "$ref": "#/$defs/typeRef" },
              "defaultValue": { "description": "Schema default as JSON; enum values are strings. Absent when there is no default." }
            }
          }
        }
      }
    }
  }
}
