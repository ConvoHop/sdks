{
  "name": "convohop-sdks",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/client",
    "packages/server",
    "conformance",
    "packages/cli",
    "packages/mcp"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces && npm run test:sdkgen && node --test test/names.test.mjs",
    "test:conformance": "npm test -w conformance",
    "conformance": "npm run build && node conformance/runner.mjs",
    "generate:conformance": "npm run build -w packages/server && node conformance/lib/webhook-vectors.mjs --write && node conformance/lib/push-vectors.mjs --write",
    "check:packages": "npm run build && npm run check:package -w packages",
    "generate:graphql": "node tools/sdkgen/cli.mjs generate",
    "check:graphql": "node tools/sdkgen/cli.mjs generate --check",
    "check:annotations": "node tools/sdkgen/cli.mjs check-annotations",
    "test:sdkgen": "node --test \"tools/sdkgen/test/*.test.mjs\"",
    "check:release": "npm run build && node --test test/release/*.test.mjs",
    "extract:docs": "node tools/docgen/cli.mjs extract",
    "generate:docs": "node tools/docgen/cli.mjs generate",
    "check:docs": "node tools/docgen/cli.mjs generate --check",
    "test:docs": "node tools/docgen/cli.mjs test",
    "test:docgen": "node --test \"tools/docgen/test/*.test.mjs\""
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "^22.20.5",
    "graphql": "17.0.2",
    "publint": "0.3.25"
  }
}
