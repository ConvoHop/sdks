{
  "$schema": "../scenario.schema.json",
  "suite": "auth",
  "title": "Authentication and authorization",
  "description": "Backend keys, user session tokens and management credentials: acceptance, scope limits, project binding and expiry.",
  "scenarios": [
    {
      "id": "auth.backend-key.accepted",
      "title": "A current backend key can call backend operations",
      "covers": ["auth.backendKey"],
      "steps": [
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" },
          "expect": { "value": { "principalId": { "$type": "uuid" } } }, "save": "alice" },
        { "do": "invoke", "client": "backend", "operation": "sessions.issue",
          "args": { "principalId": "${saved.alice.principalId}", "deviceId": "${uuid.aliceDevice}" },
          "expect": { "value": {
            "session": { "sessionId": { "$type": "uuid" }, "principalId": "${saved.alice.principalId}", "deviceId": "${uuid.aliceDevice}",
              "incarnation": "${target.incarnation}", "expiresAt": { "$type": "timestamp" }, "status": "active" },
            "tokenExpiresAt": { "$type": "timestamp" },
            "sessionToken": { "$type": "string", "$length": { "$gte": 16 } } } } }
      ]
    },
    {
      "id": "auth.backend-key.invalid",
      "title": "An unknown backend key is rejected as unauthenticated",
      "covers": ["auth.backendKey", "errors"],
      "steps": [
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "invalid-backend-key-${nonce}" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" },
          "expect": { "error": { "code": "UNAUTHENTICATED", "status": 401, "outcome": "rejected", "requestId": { "$type": "uuid" } } } }
      ]
    },
    {
      "id": "auth.backend-key.wrong-project",
      "title": "A backend key is only valid for its own project",
      "covers": ["auth.backendKey", "auth.scopes"],
      "steps": [
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "${target.credentials.backend}", "projectId": "${uuid.otherProject}" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" },
          "expect": { "error": { "code": "FORBIDDEN", "status": 403, "outcome": "rejected" } } }
      ]
    },
    {
      "id": "auth.backend-key.expired",
      "title": "An expired backend key is rejected as unauthenticated",
      "covers": ["auth.backendKey", "auth.expiry"],
      "steps": [
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "${target.credentials.backendExpired}" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" },
          "expect": { "error": { "code": "UNAUTHENTICATED", "status": 401, "outcome": "rejected" } } }
      ]
    },
    {
      "id": "auth.scopes.limited-backend-key",
      "title": "A backend key can only perform operations its scopes allow",
      "description": "credentials.backendLimited has every backend scope except membershipManage, which members and addMembers require. A missing scope is SCOPE_REQUIRED, not FORBIDDEN.",
      "covers": ["auth.scopes", "auth.backendKey"],
      "steps": [
        { "do": "client.create", "client": "limited", "role": "backend", "credential": "${target.credentials.backendLimited}" },
        { "do": "invoke", "client": "limited", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" }, "save": "alice" },
        { "do": "invoke", "client": "limited", "operation": "principals.create", "args": { "externalUserId": "bob-${nonce}" }, "save": "bob" },
        { "do": "invoke", "client": "limited", "operation": "conversations.create",
          "args": { "input": { "title": "Scopes ${nonce}", "props": {}, "members": [{ "principalId": "${saved.alice.principalId}", "role": "member" }] } },
          "save": "conversation" },
        { "do": "invoke", "client": "limited", "operation": "members.list", "args": { "conversationId": "${saved.conversation.conversationId}", "limit": 10 },
          "expect": { "error": { "code": "SCOPE_REQUIRED", "status": 403, "outcome": "rejected" } } },
        { "do": "invoke", "client": "limited", "operation": "members.add",
          "args": { "conversationId": "${saved.conversation.conversationId}",
            "members": [{ "principalId": "${saved.bob.principalId}", "role": "member", "expectedRevision": "0" }] },
          "expect": { "error": { "code": "SCOPE_REQUIRED", "status": 403, "outcome": "rejected" } } },
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "backend", "operation": "members.list", "args": { "conversationId": "${saved.conversation.conversationId}", "limit": 10 },
          "note": "The rejected call must not have changed membership.",
          "expect": { "value": { "items": [{ "principalId": "${saved.alice.principalId}" }], "complete": true } } }
      ]
    },
    {
      "id": "auth.scopes.user-token-is-not-a-backend-key",
      "title": "A user session token cannot be used as a backend key",
      "covers": ["auth.scopes", "auth.userToken"],
      "steps": [
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" }, "save": "alice" },
        { "do": "invoke", "client": "backend", "operation": "sessions.issue",
          "args": { "principalId": "${saved.alice.principalId}", "deviceId": "${uuid.aliceDevice}" }, "save": "aliceSession" },
        { "do": "client.create", "client": "impostor", "role": "backend", "credential": "${saved.aliceSession.sessionToken}" },
        { "do": "invoke", "client": "impostor", "operation": "principals.create", "args": { "externalUserId": "mallory-${nonce}" },
          "expect": { "error": { "code": "FORBIDDEN", "status": 403, "outcome": "rejected" } } }
      ]
    },
    {
      "id": "auth.scopes.backend-key-is-not-a-management-credential",
      "title": "A backend key cannot call the management plane",
      "covers": ["auth.scopes", "auth.backendKey"],
      "steps": [
        { "do": "client.create", "client": "management", "role": "management", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "management", "operation": "backendKeys.issue",
          "args": { "projectId": "${target.projectId}", "name": "conformance-${nonce}", "scopes": ["principalManage"], "expiresAt": "${clock.isoPlusMs.3600000}" },
          "expect": { "error": { "code": "UNAUTHENTICATED", "status": 401, "outcome": "rejected" } } }
      ]
    },
    {
      "id": "auth.scopes.management-issues-scoped-key",
      "title": "A management credential requests a scoped backend key and unknown scopes are refused",
      "description": "Key issuance is asynchronous: the reply is an accepted receipt and the secret is delivered out of band.",
      "covers": ["auth.scopes"],
      "steps": [
        { "do": "client.create", "client": "management", "role": "management", "credential": "${target.credentials.management}" },
        { "do": "invoke", "client": "management", "operation": "backendKeys.issue",
          "args": { "projectId": "${target.projectId}", "name": "conformance-${nonce}", "scopes": ["principalManage", "sessionIssue"],
            "expiresAt": "${clock.isoPlusMs.3600000}" },
          "expect": { "value": {
            "status": "accepted", "requestId": { "$type": "uuid" }, "result": null,
            "operation": { "operationId": { "$type": "uuid" }, "owner": "management", "state": { "$type": "string" } },
            "resourceRef": { "kind": "backendKey", "id": { "$type": "uuid" } } } } },
        { "do": "invoke", "client": "management", "operation": "backendKeys.issue",
          "args": { "projectId": "${target.projectId}", "name": "conformance-${nonce}", "scopes": ["notAScope"], "expiresAt": "${clock.isoPlusMs.3600000}" },
          "expect": { "error": { "code": "INVALID_REQUEST", "outcome": "rejected" } } }
      ]
    },
    {
      "id": "auth.management.invalid-credential",
      "title": "An unknown management credential is rejected as unauthenticated",
      "covers": ["auth.scopes", "errors"],
      "steps": [
        { "do": "client.create", "client": "management", "role": "management", "credential": "invalid-management-credential-${nonce}" },
        { "do": "invoke", "client": "management", "operation": "backendKeys.issue",
          "args": { "projectId": "${target.projectId}", "name": "conformance-${nonce}", "scopes": ["principalManage"], "expiresAt": "${clock.isoPlusMs.3600000}" },
          "expect": { "error": { "code": "UNAUTHENTICATED", "status": 401, "outcome": "rejected" } } }
      ]
    },
    {
      "id": "auth.user-token.accepted",
      "title": "A user session token reads the signed route and the user's own membership",
      "covers": ["auth.userToken"],
      "steps": [
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" }, "save": "alice" },
        { "do": "invoke", "client": "backend", "operation": "conversations.create",
          "args": { "input": { "title": "Auth ${nonce}", "props": {}, "members": [{ "principalId": "${saved.alice.principalId}", "role": "member" }] } },
          "save": "conversation" },
        { "do": "invoke", "client": "backend", "operation": "sessions.issue",
          "args": { "principalId": "${saved.alice.principalId}", "deviceId": "${uuid.aliceDevice}" }, "save": "aliceSession" },
        { "do": "client.create", "client": "alice", "role": "user", "credential": "${saved.aliceSession.sessionToken}", "principalId": "${saved.alice.principalId}" },
        { "do": "invoke", "client": "alice", "operation": "route.initialize",
          "expect": { "value": { "projectId": "${target.projectId}", "incarnation": "${target.incarnation}", "servingEpoch": { "$type": "counter" },
            "expiresAt": { "$type": "timestamp" }, "signature": { "$type": "string" } } } },
        { "do": "invoke", "client": "alice", "operation": "conversations.get", "args": { "conversationId": "${saved.conversation.conversationId}" },
          "expect": { "value": { "conversationId": "${saved.conversation.conversationId}", "title": "Auth ${nonce}",
            "membership": { "conversationId": "${saved.conversation.conversationId}", "principalId": "${saved.alice.principalId}", "role": "member", "status": "active" } } } }
      ]
    },
    {
      "id": "auth.user-token.invalid",
      "title": "An unknown user session token is rejected as unauthenticated",
      "covers": ["auth.userToken", "errors"],
      "steps": [
        { "do": "client.create", "client": "alice", "role": "user", "credential": "invalid-session-token-${nonce}", "principalId": "${uuid.alice}" },
        { "do": "invoke", "client": "alice", "operation": "conversations.get", "args": { "conversationId": "${uuid.conversation}" },
          "expect": { "error": { "code": "UNAUTHENTICATED", "status": 401, "outcome": "rejected" } } }
      ]
    },
    {
      "id": "auth.user-token.wrong-project",
      "title": "A user session token is only valid for its own project",
      "covers": ["auth.userToken", "auth.scopes"],
      "steps": [
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" }, "save": "alice" },
        { "do": "invoke", "client": "backend", "operation": "conversations.create",
          "args": { "input": { "title": "Auth ${nonce}", "props": {}, "members": [{ "principalId": "${saved.alice.principalId}", "role": "member" }] } },
          "save": "conversation" },
        { "do": "invoke", "client": "backend", "operation": "sessions.issue",
          "args": { "principalId": "${saved.alice.principalId}", "deviceId": "${uuid.aliceDevice}" }, "save": "aliceSession" },
        { "do": "client.create", "client": "alice", "role": "user", "credential": "${saved.aliceSession.sessionToken}",
          "principalId": "${saved.alice.principalId}", "projectId": "${uuid.otherProject}" },
        { "do": "invoke", "client": "alice", "operation": "conversations.get", "args": { "conversationId": "${saved.conversation.conversationId}" },
          "expect": { "error": { "code": "FORBIDDEN", "status": 403, "outcome": "rejected" } } }
      ]
    },
    {
      "id": "auth.user-token.non-member",
      "title": "A user cannot read or write a conversation they are not a member of",
      "description": "Absence and denial look identical so conversation ids cannot be probed.",
      "covers": ["auth.userToken", "auth.scopes", "errors"],
      "steps": [
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" }, "save": "alice" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "carol-${nonce}" }, "save": "carol" },
        { "do": "invoke", "client": "backend", "operation": "conversations.create",
          "args": { "input": { "title": "Private ${nonce}", "props": {}, "members": [{ "principalId": "${saved.alice.principalId}", "role": "member" }] } },
          "save": "conversation" },
        { "do": "invoke", "client": "backend", "operation": "sessions.issue",
          "args": { "principalId": "${saved.carol.principalId}", "deviceId": "${uuid.carolDevice}" }, "save": "carolSession" },
        { "do": "client.create", "client": "carol", "role": "user", "credential": "${saved.carolSession.sessionToken}", "principalId": "${saved.carol.principalId}" },
        { "do": "invoke", "client": "carol", "operation": "conversations.get", "args": { "conversationId": "${saved.conversation.conversationId}" },
          "expect": { "error": { "code": "NOT_FOUND", "status": 404, "outcome": "rejected" } } },
        { "do": "invoke", "client": "carol", "operation": "conversations.get", "args": { "conversationId": "${uuid.missingConversation}" },
          "expect": { "error": { "code": "NOT_FOUND", "status": 404, "outcome": "rejected" } } },
        { "do": "invoke", "client": "carol", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "let me in" },
          "expect": { "error": { "code": "NOT_FOUND", "status": 404, "outcome": "rejected" } } }
      ]
    },
    {
      "id": "auth.expiry.user-session",
      "title": "A user session token stops working when it expires",
      "covers": ["auth.expiry", "auth.userToken"],
      "requires": { "capabilities": ["auth.shortSessionTtl"] },
      "steps": [
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" }, "save": "alice" },
        { "do": "invoke", "client": "backend", "operation": "conversations.create",
          "args": { "input": { "title": "Expiry ${nonce}", "props": {}, "members": [{ "principalId": "${saved.alice.principalId}", "role": "member" }] } },
          "save": "conversation" },
        { "do": "invoke", "client": "backend", "operation": "sessions.issue",
          "args": { "principalId": "${saved.alice.principalId}", "deviceId": "${uuid.aliceDevice}", "requestedTtlMs": "1000" },
          "expect": { "value": { "tokenExpiresAt": { "$type": "timestamp" }, "session": { "status": "active" } } }, "save": "aliceSession" },
        { "do": "client.create", "client": "alice", "role": "user", "credential": "${saved.aliceSession.sessionToken}", "principalId": "${saved.alice.principalId}" },
        { "do": "invoke", "client": "alice", "operation": "conversations.get", "args": { "conversationId": "${saved.conversation.conversationId}" } },
        { "do": "sleep", "ms": 1500 },
        { "do": "invoke", "client": "alice", "operation": "conversations.get", "args": { "conversationId": "${saved.conversation.conversationId}" },
          "expect": { "error": { "code": "UNAUTHENTICATED", "status": 401, "outcome": "rejected" } } }
      ]
    }
  ]
}
