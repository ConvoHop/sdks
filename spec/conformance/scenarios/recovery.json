{
  "$schema": "../scenario.schema.json",
  "suite": "recovery",
  "title": "Unknown outcomes and recovery",
  "description": "When the transport fails after submission the outcome is unknown, not rejected. Callers resolve the original request id read-only and retry only what the service never observed. SDKs keep at most 128 mutation records and evict only final ones (spec/recovery/README.md#recovery-journal).",
  "scenarios": [
    {
      "id": "recovery.resolve.never-observed",
      "title": "Resolving a request id the service never saw reports notObservedYet",
      "covers": ["recovery"],
      "steps": [
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "backend", "operation": "route.initialize" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" }, "save": "alice" },
        { "do": "invoke", "client": "backend", "operation": "sessions.issue",
          "args": { "principalId": "${saved.alice.principalId}", "deviceId": "${uuid.aliceDevice}" }, "save": "aliceSession" },
        { "do": "client.create", "client": "alice", "role": "user", "credential": "${saved.aliceSession.sessionToken}", "principalId": "${saved.alice.principalId}" },
        { "do": "invoke", "client": "alice", "operation": "route.initialize" },
        { "do": "invoke", "client": "alice", "operation": "requests.resolve", "args": { "requestId": "${uuid.neverSent}" },
          "expect": { "value": { "state": "notObservedYet", "requestId": "${uuid.neverSent}", "receipt": null } } }
      ]
    },
    {
      "id": "recovery.drop-after-commit.resolve",
      "title": "A response lost after commit is an unknown outcome that resolves to the committed message",
      "covers": ["recovery", "errors"],
      "steps": [
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "backend", "operation": "route.initialize" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" }, "save": "alice" },
        { "do": "invoke", "client": "backend", "operation": "conversations.create",
          "args": { "input": { "title": "Lost replies ${nonce}", "props": {}, "members": [{ "principalId": "${saved.alice.principalId}", "role": "member" }] } },
          "save": "conversation" },
        { "do": "invoke", "client": "backend", "operation": "sessions.issue",
          "args": { "principalId": "${saved.alice.principalId}", "deviceId": "${uuid.aliceDevice}" }, "save": "aliceSession" },
        { "do": "client.create", "client": "alice", "role": "user", "credential": "${saved.aliceSession.sessionToken}", "principalId": "${saved.alice.principalId}" },
        { "do": "invoke", "client": "alice", "operation": "route.initialize" },
        { "do": "control.fault", "field": "sendMessage", "action": "dropAfterCommit" },
        { "do": "invoke", "client": "alice", "operation": "messages.send",
          "args": { "conversationId": "${saved.conversation.conversationId}", "text": "did it land?", "requestId": "${uuid.send}" },
          "note": "Transport uncertainty is neither a rejection nor a commit, and there is no HTTP status.",
          "expect": { "error": { "code": "TRANSPORT_UNKNOWN", "status": null, "outcome": "unknown", "requestId": "${uuid.send}" } } },
        { "do": "invoke", "client": "alice", "operation": "requests.resolve", "args": { "requestId": "${uuid.send}" },
          "expect": { "value": { "state": "committed", "requestId": "${uuid.send}",
            "receipt": { "status": "committed", "requestId": "${uuid.send}",
              "result": { "messageAck": { "messageId": { "$type": "uuid" }, "conversationId": "${saved.conversation.conversationId}", "sequence": { "$type": "counter" } } } } } },
          "save": "resolution" },
        { "do": "invoke", "client": "alice", "operation": "messages.list", "args": { "conversationId": "${saved.conversation.conversationId}" },
          "expect": { "value": { "items": [{ "messageId": "${saved.resolution.receipt.result.messageAck.messageId}", "text": "did it land?" }] } } }
      ]
    },
    {
      "id": "recovery.drop-before-commit.retry",
      "title": "A request the service never observed is retried with its original id and payload",
      "covers": ["recovery", "idempotency"],
      "steps": [
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "backend", "operation": "route.initialize" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" }, "save": "alice" },
        { "do": "invoke", "client": "backend", "operation": "conversations.create",
          "args": { "input": { "title": "Lost requests ${nonce}", "props": {}, "members": [{ "principalId": "${saved.alice.principalId}", "role": "member" }] } },
          "save": "conversation" },
        { "do": "invoke", "client": "backend", "operation": "sessions.issue",
          "args": { "principalId": "${saved.alice.principalId}", "deviceId": "${uuid.aliceDevice}" }, "save": "aliceSession" },
        { "do": "client.create", "client": "alice", "role": "user", "credential": "${saved.aliceSession.sessionToken}", "principalId": "${saved.alice.principalId}" },
        { "do": "invoke", "client": "alice", "operation": "route.initialize" },
        { "do": "control.fault", "field": "sendMessage", "action": "dropBeforeCommit" },
        { "do": "invoke", "client": "alice", "operation": "messages.send",
          "args": { "conversationId": "${saved.conversation.conversationId}", "text": "second time lucky", "requestId": "${uuid.send}" },
          "expect": { "error": { "code": "TRANSPORT_UNKNOWN", "status": null, "outcome": "unknown", "requestId": "${uuid.send}" } } },
        { "do": "invoke", "client": "alice", "operation": "requests.resolve", "args": { "requestId": "${uuid.send}" },
          "expect": { "value": { "state": "notObservedYet", "receipt": null } } },
        { "do": "invoke", "client": "alice", "operation": "requests.retry", "args": { "requestId": "${uuid.send}" },
          "expect": { "value": { "state": "committed", "requestId": "${uuid.send}",
            "receipt": { "status": "committed", "result": { "messageAck": { "messageId": { "$type": "uuid" } } } } } },
          "save": "retried" },
        { "do": "control.waitLog", "kind": "request", "match": { "field": "sendMessage", "requestId": "${uuid.send}" }, "count": 2,
          "note": "The retry resends the original request id: one dropped attempt, then one that committed.",
          "expect": [{ "dropped": true }, { "dropped": false, "status": 200 }] },
        { "do": "invoke", "client": "alice", "operation": "messages.list", "args": { "conversationId": "${saved.conversation.conversationId}" },
          "expect": { "value": { "items": [{ "messageId": "${saved.retried.receipt.result.messageAck.messageId}", "text": "second time lucky" }] } } }
      ]
    },
    {
      "id": "recovery.retry-after-commit",
      "title": "Retrying a request that already committed returns the commit without a duplicate",
      "covers": ["recovery", "idempotency"],
      "steps": [
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "backend", "operation": "route.initialize" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" }, "save": "alice" },
        { "do": "invoke", "client": "backend", "operation": "conversations.create",
          "args": { "input": { "title": "Committed ${nonce}", "props": {}, "members": [{ "principalId": "${saved.alice.principalId}", "role": "member" }] } },
          "save": "conversation" },
        { "do": "invoke", "client": "backend", "operation": "sessions.issue",
          "args": { "principalId": "${saved.alice.principalId}", "deviceId": "${uuid.aliceDevice}" }, "save": "aliceSession" },
        { "do": "client.create", "client": "alice", "role": "user", "credential": "${saved.aliceSession.sessionToken}", "principalId": "${saved.alice.principalId}" },
        { "do": "invoke", "client": "alice", "operation": "route.initialize" },
        { "do": "control.fault", "field": "sendMessage", "action": "dropAfterCommit" },
        { "do": "invoke", "client": "alice", "operation": "messages.send",
          "args": { "conversationId": "${saved.conversation.conversationId}", "text": "only once", "requestId": "${uuid.send}" },
          "expect": { "error": { "code": "TRANSPORT_UNKNOWN", "outcome": "unknown" } } },
        { "do": "invoke", "client": "alice", "operation": "requests.retry", "args": { "requestId": "${uuid.send}" },
          "note": "Whether the SDK resends or answers from the resolution, the service must not commit twice.",
          "expect": { "value": { "state": "committed", "receipt": { "result": { "messageAck": { "messageId": { "$type": "uuid" } } } } } },
          "save": "retried" },
        { "do": "invoke", "client": "alice", "operation": "messages.list", "args": { "conversationId": "${saved.conversation.conversationId}" },
          "expect": { "value": { "items": [{ "messageId": "${saved.retried.receipt.result.messageAck.messageId}", "text": "only once" }] } } }
      ]
    },
    {
      "id": "recovery.storage.restart",
      "title": "A restarted client retries an unknown request from caller-approved recovery storage",
      "description": "The storage holds request identity and payload only, never credentials; the new client is given the session token again.",
      "covers": ["recovery", "idempotency"],
      "steps": [
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "backend", "operation": "route.initialize" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" }, "save": "alice" },
        { "do": "invoke", "client": "backend", "operation": "conversations.create",
          "args": { "input": { "title": "Restarts ${nonce}", "props": {}, "members": [{ "principalId": "${saved.alice.principalId}", "role": "member" }] } },
          "save": "conversation" },
        { "do": "invoke", "client": "backend", "operation": "sessions.issue",
          "args": { "principalId": "${saved.alice.principalId}", "deviceId": "${uuid.aliceDevice}" }, "save": "aliceSession" },
        { "do": "client.create", "client": "alice1", "role": "user", "credential": "${saved.aliceSession.sessionToken}",
          "principalId": "${saved.alice.principalId}", "storage": "aliceDevice" },
        { "do": "invoke", "client": "alice1", "operation": "route.initialize" },
        { "do": "control.fault", "field": "sendMessage", "action": "dropBeforeCommit" },
        { "do": "invoke", "client": "alice1", "operation": "messages.send",
          "args": { "conversationId": "${saved.conversation.conversationId}", "text": "sent before the crash", "requestId": "${uuid.send}" },
          "expect": { "error": { "code": "TRANSPORT_UNKNOWN", "outcome": "unknown", "requestId": "${uuid.send}" } } },
        { "do": "client.close", "client": "alice1" },
        { "do": "client.create", "client": "alice2", "role": "user", "credential": "${saved.aliceSession.sessionToken}",
          "principalId": "${saved.alice.principalId}", "storage": "aliceDevice" },
        { "do": "invoke", "client": "alice2", "operation": "route.initialize" },
        { "do": "invoke", "client": "alice2", "operation": "requests.retry", "args": { "requestId": "${uuid.send}" },
          "expect": { "value": { "state": "committed", "requestId": "${uuid.send}" } } },
        { "do": "invoke", "client": "alice2", "operation": "messages.list", "args": { "conversationId": "${saved.conversation.conversationId}" },
          "expect": { "value": { "items": [{ "text": "sent before the crash" }] } } }
      ]
    },
    {
      "id": "recovery.eviction.final-records.user",
      "title": "A full recovery journal makes room by evicting final records, never one whose outcome is unknown",
      "description": "SDKs keep at most 128 mutation records (spec/recovery/README.md#recovery-journal). A REVISION_CONFLICT rejection is final, so once the journal is full the oldest final record makes room; a record whose outcome is unknown stays until it settles.",
      "covers": ["recovery", "idempotency"],
      "steps": [
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "backend", "operation": "route.initialize" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" }, "save": "alice" },
        { "do": "invoke", "client": "backend", "operation": "conversations.create",
          "args": { "input": { "title": "Full journal ${nonce}", "props": {}, "members": [{ "principalId": "${saved.alice.principalId}", "role": "member" }] } },
          "save": "conversation" },
        { "do": "invoke", "client": "backend", "operation": "sessions.issue",
          "args": { "principalId": "${saved.alice.principalId}", "deviceId": "${uuid.aliceDevice}" }, "save": "aliceSession" },
        { "do": "client.create", "client": "alice", "role": "user", "credential": "${saved.aliceSession.sessionToken}", "principalId": "${saved.alice.principalId}" },
        { "do": "invoke", "client": "alice", "operation": "route.initialize" },
        { "do": "invoke", "client": "alice", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "first draft" } },
        { "do": "invoke", "client": "alice", "operation": "messages.list", "args": { "conversationId": "${saved.conversation.conversationId}" }, "save": "page" },
        { "do": "invoke", "client": "alice", "operation": "messages.edit", "args": { "message": "${saved.page.items.0}", "text": "second draft" },
          "expect": { "value": { "revision": "2" } } },
        { "do": "control.fault", "field": "sendMessage", "action": "dropBeforeCommit" },
        { "do": "invoke", "client": "alice", "operation": "messages.send",
          "args": { "conversationId": "${saved.conversation.conversationId}", "text": "kept for retry", "requestId": "${uuid.lost}" },
          "expect": { "error": { "code": "TRANSPORT_UNKNOWN", "outcome": "unknown", "requestId": "${uuid.lost}" } } },
        { "do": "invoke", "client": "alice", "operation": "messages.edit", "args": { "message": "${saved.page.items.0}", "text": "stale draft" },
          "repeat": 129, "requires": ["recovery.eviction"],
          "note": "One more than the journal holds. Each call is a new request from revision 1, so the last ones fit only if older final records were evicted.",
          "expect": { "error": { "code": "REVISION_CONFLICT", "status": 409, "outcome": "rejected" } } },
        { "do": "control.waitLog", "kind": "request", "match": { "field": "editMessage" }, "count": 130,
          "note": "Every edit reached the service: none was refused locally.",
          "expect": { "$length": 130 } },
        { "do": "invoke", "client": "alice", "operation": "requests.retry", "args": { "requestId": "${uuid.lost}" },
          "note": "The unknown send was older than every rejection, yet it was kept and still retries under its own id.",
          "expect": { "value": { "state": "committed", "requestId": "${uuid.lost}", "receipt": { "status": "committed" } } } }
      ]
    },
    {
      "id": "recovery.eviction.final-records.backend",
      "title": "A backend client's full recovery journal makes room by evicting final records",
      "description": "The same 128-record journal and eviction rule as recovery.eviction.final-records.user, on a backend key.",
      "covers": ["recovery", "auth.backendKey"],
      "steps": [
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "backend", "operation": "route.initialize" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" }, "save": "alice" },
        { "do": "invoke", "client": "backend", "operation": "conversations.create",
          "args": { "input": { "title": "Full journal ${nonce}", "props": {}, "members": [{ "principalId": "${saved.alice.principalId}", "role": "member" }] } },
          "save": "conversation" },
        { "do": "invoke", "client": "backend", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "first draft" } },
        { "do": "invoke", "client": "backend", "operation": "messages.list", "args": { "conversationId": "${saved.conversation.conversationId}" }, "save": "page" },
        { "do": "invoke", "client": "backend", "operation": "messages.edit", "args": { "message": "${saved.page.items.0}", "text": "second draft" },
          "expect": { "value": { "revision": "2" } } },
        { "do": "invoke", "client": "backend", "operation": "messages.edit", "args": { "message": "${saved.page.items.0}", "text": "stale draft" },
          "repeat": 129, "requires": ["recovery.eviction"],
          "note": "One more than the journal holds. Each call is a new request from revision 1, so the last ones fit only if older final records were evicted.",
          "expect": { "error": { "code": "REVISION_CONFLICT", "status": 409, "outcome": "rejected" } } },
        { "do": "control.waitLog", "kind": "request", "match": { "field": "editMessage" }, "count": 130,
          "note": "Every edit reached the service: none was refused locally.",
          "expect": { "$length": 130 } }
      ]
    },
    {
      "id": "recovery.eviction.fail-closed.user",
      "title": "A journal full of records that may still be retried refuses new requests with RECOVERY_LIMIT",
      "description": "A RATE_LIMITED rejection stays retryable under its request id, so it is not final and is never evicted. With 128 of them the next new request fails before it is sent, while the kept requests still retry.",
      "covers": ["recovery", "errors", "idempotency"],
      "steps": [
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "backend", "operation": "route.initialize" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" }, "save": "alice" },
        { "do": "invoke", "client": "backend", "operation": "conversations.create",
          "args": { "input": { "title": "Full journal ${nonce}", "props": {}, "members": [{ "principalId": "${saved.alice.principalId}", "role": "member" }] } },
          "save": "conversation" },
        { "do": "invoke", "client": "backend", "operation": "sessions.issue",
          "args": { "principalId": "${saved.alice.principalId}", "deviceId": "${uuid.aliceDevice}" }, "save": "aliceSession" },
        { "do": "client.create", "client": "alice", "role": "user", "credential": "${saved.aliceSession.sessionToken}", "principalId": "${saved.alice.principalId}" },
        { "do": "invoke", "client": "alice", "operation": "route.initialize" },
        { "do": "control.fault", "field": "sendMessage", "action": "rateLimit", "retryAfterSeconds": 1, "count": 128 },
        { "do": "invoke", "client": "alice", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "throttled" },
          "repeat": 128, "requires": ["recovery.eviction"],
          "expect": { "error": { "code": "RATE_LIMITED", "status": 429, "outcome": "rejected" } }, "save": "limited" },
        { "do": "invoke", "client": "alice", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "one too many" },
          "note": "Nothing can be evicted, so the SDK fails closed with a typed problem instead of dropping a record the app may retry.",
          "expect": { "error": { "code": "RECOVERY_LIMIT", "status": 409, "outcome": "rejected", "requestId": { "$type": "uuid" } } } },
        { "do": "control.waitLog", "kind": "request", "match": { "field": "sendMessage" }, "count": 128,
          "note": "The refused request was never sent.",
          "expect": { "$length": 128 } },
        { "do": "sleep", "ms": 1000, "note": "Honour the one-second retry-after." },
        { "do": "invoke", "client": "alice", "operation": "requests.retry", "args": { "requestId": "${saved.limited.requestId}" },
          "note": "A full journal still retries a kept request under its own id.",
          "expect": { "value": { "state": "committed", "requestId": "${saved.limited.requestId}", "receipt": { "status": "committed" } } } },
        { "do": "invoke", "client": "alice", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "room again" },
          "note": "The retried request committed, so its record is final and makes room.",
          "expect": { "value": { "status": "sent" } } }
      ]
    },
    {
      "id": "recovery.eviction.fail-closed.backend",
      "title": "A backend client's journal full of retryable records refuses new requests with RECOVERY_LIMIT",
      "description": "The same rule as recovery.eviction.fail-closed.user, on a backend key; the kept request is resubmitted with its own request id.",
      "covers": ["recovery", "errors", "idempotency"],
      "steps": [
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "backend", "operation": "route.initialize" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" }, "save": "alice" },
        { "do": "invoke", "client": "backend", "operation": "conversations.create",
          "args": { "input": { "title": "Full journal ${nonce}", "props": {}, "members": [{ "principalId": "${saved.alice.principalId}", "role": "member" }] } },
          "save": "conversation" },
        { "do": "control.fault", "field": "sendMessage", "action": "rateLimit", "retryAfterSeconds": 1, "count": 128 },
        { "do": "invoke", "client": "backend", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "throttled" },
          "repeat": 128, "requires": ["recovery.eviction"],
          "expect": { "error": { "code": "RATE_LIMITED", "status": 429, "outcome": "rejected" } }, "save": "limited" },
        { "do": "invoke", "client": "backend", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "one too many" },
          "expect": { "error": { "code": "RECOVERY_LIMIT", "status": 409, "outcome": "rejected", "requestId": { "$type": "uuid" } } } },
        { "do": "control.waitLog", "kind": "request", "match": { "field": "sendMessage" }, "count": 128,
          "note": "The refused request was never sent.",
          "expect": { "$length": 128 } },
        { "do": "sleep", "ms": 1000, "note": "Honour the one-second retry-after." },
        { "do": "invoke", "client": "backend", "operation": "messages.send",
          "args": { "conversationId": "${saved.conversation.conversationId}", "text": "throttled", "requestId": "${saved.limited.requestId}" },
          "note": "Resubmitting a kept request under its own id needs no new record.",
          "expect": { "value": { "status": "sent", "messageId": { "$type": "uuid" } } } },
        { "do": "invoke", "client": "backend", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "room again" },
          "note": "The resubmitted request committed, so its record is final and makes room.",
          "expect": { "value": { "status": "sent" } } }
      ]
    }
  ]
}
