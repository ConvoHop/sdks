{
  "$schema": "../scenario.schema.json",
  "suite": "idempotency",
  "title": "Idempotency",
  "description": "Request ids make mutations safe to replay: the same id and payload return the original result, and a different payload under the same id is a conflict.",
  "scenarios": [
    {
      "id": "idempotency.messages.same-client-replay",
      "title": "Replaying a send with the same request id returns the original message",
      "covers": ["idempotency"],
      "steps": [
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" }, "save": "alice" },
        { "do": "invoke", "client": "backend", "operation": "conversations.create",
          "args": { "input": { "title": "Replays ${nonce}", "props": {}, "members": [{ "principalId": "${saved.alice.principalId}", "role": "member" }] } },
          "save": "conversation" },
        { "do": "invoke", "client": "backend", "operation": "sessions.issue",
          "args": { "principalId": "${saved.alice.principalId}", "deviceId": "${uuid.aliceDevice}" }, "save": "aliceSession" },
        { "do": "client.create", "client": "alice", "role": "user", "credential": "${saved.aliceSession.sessionToken}", "principalId": "${saved.alice.principalId}" },
        { "do": "invoke", "client": "alice", "operation": "messages.send",
          "args": { "conversationId": "${saved.conversation.conversationId}", "text": "exactly once", "requestId": "${uuid.send}" },
          "expect": { "value": { "status": "sent", "messageId": { "$type": "uuid" }, "revision": "1" } }, "save": "first" },
        { "do": "invoke", "client": "alice", "operation": "messages.send",
          "args": { "conversationId": "${saved.conversation.conversationId}", "text": "exactly once", "requestId": "${uuid.send}" },
          "expect": { "value": { "status": "sent", "messageId": "${saved.first.messageId}", "sequence": "${saved.first.sequence}", "cursor": "${saved.first.cursor}" } } },
        { "do": "invoke", "client": "alice", "operation": "messages.list", "args": { "conversationId": "${saved.conversation.conversationId}" },
          "expect": { "value": { "items": [{ "messageId": "${saved.first.messageId}", "text": "exactly once" }] } } }
      ]
    },
    {
      "id": "idempotency.messages.new-client-replay",
      "title": "A new client replaying the same request id and payload gets the original message",
      "description": "Models an app restart that resubmits a send it never saw acknowledged.",
      "covers": ["idempotency"],
      "steps": [
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" }, "save": "alice" },
        { "do": "invoke", "client": "backend", "operation": "conversations.create",
          "args": { "input": { "title": "Restarts ${nonce}", "props": {}, "members": [{ "principalId": "${saved.alice.principalId}", "role": "member" }] } },
          "save": "conversation" },
        { "do": "invoke", "client": "backend", "operation": "sessions.issue",
          "args": { "principalId": "${saved.alice.principalId}", "deviceId": "${uuid.aliceDevice}" }, "save": "aliceSession" },
        { "do": "client.create", "client": "alice1", "role": "user", "credential": "${saved.aliceSession.sessionToken}", "principalId": "${saved.alice.principalId}" },
        { "do": "invoke", "client": "alice1", "operation": "messages.send",
          "args": { "conversationId": "${saved.conversation.conversationId}", "text": "survives restarts", "requestId": "${uuid.send}" },
          "save": "first" },
        { "do": "client.close", "client": "alice1" },
        { "do": "client.create", "client": "alice2", "role": "user", "credential": "${saved.aliceSession.sessionToken}", "principalId": "${saved.alice.principalId}" },
        { "do": "invoke", "client": "alice2", "operation": "messages.send",
          "args": { "conversationId": "${saved.conversation.conversationId}", "text": "survives restarts", "requestId": "${uuid.send}" },
          "expect": { "value": { "messageId": "${saved.first.messageId}", "sequence": "${saved.first.sequence}" } } },
        { "do": "invoke", "client": "alice2", "operation": "messages.list", "args": { "conversationId": "${saved.conversation.conversationId}" },
          "expect": { "value": { "items": { "$length": 1 } } } }
      ]
    },
    {
      "id": "idempotency.messages.conflict",
      "title": "Reusing a request id with a different payload is a conflict and the original message is unchanged",
      "description": "A fresh client gets the service's definitive rejection. A client that still holds the original request may refuse locally before sending, so the outcome is only pinned for the fresh client.",
      "covers": ["idempotency", "errors"],
      "steps": [
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" }, "save": "alice" },
        { "do": "invoke", "client": "backend", "operation": "conversations.create",
          "args": { "input": { "title": "Conflicts ${nonce}", "props": {}, "members": [{ "principalId": "${saved.alice.principalId}", "role": "member" }] } },
          "save": "conversation" },
        { "do": "invoke", "client": "backend", "operation": "sessions.issue",
          "args": { "principalId": "${saved.alice.principalId}", "deviceId": "${uuid.aliceDevice}" }, "save": "aliceSession" },
        { "do": "client.create", "client": "alice", "role": "user", "credential": "${saved.aliceSession.sessionToken}", "principalId": "${saved.alice.principalId}" },
        { "do": "invoke", "client": "alice", "operation": "messages.send",
          "args": { "conversationId": "${saved.conversation.conversationId}", "text": "original", "requestId": "${uuid.send}" }, "save": "first" },
        { "do": "invoke", "client": "alice", "operation": "messages.send",
          "args": { "conversationId": "${saved.conversation.conversationId}", "text": "changed", "requestId": "${uuid.send}" },
          "expect": { "error": { "code": "IDEMPOTENCY_CONFLICT", "status": 409, "requestId": "${uuid.send}" } } },
        { "do": "client.create", "client": "fresh", "role": "user", "credential": "${saved.aliceSession.sessionToken}", "principalId": "${saved.alice.principalId}" },
        { "do": "invoke", "client": "fresh", "operation": "messages.send",
          "args": { "conversationId": "${saved.conversation.conversationId}", "text": "changed", "requestId": "${uuid.send}" },
          "expect": { "error": { "code": "IDEMPOTENCY_CONFLICT", "status": 409, "outcome": "rejected", "requestId": "${uuid.send}" } } },
        { "do": "invoke", "client": "fresh", "operation": "messages.list", "args": { "conversationId": "${saved.conversation.conversationId}" },
          "expect": { "value": { "items": [{ "messageId": "${saved.first.messageId}", "text": "original", "revision": "1" }] } } }
      ]
    },
    {
      "id": "idempotency.messages.edit-replay",
      "title": "Replaying an edit returns the edited message instead of a revision conflict",
      "covers": ["idempotency"],
      "steps": [
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" }, "save": "alice" },
        { "do": "invoke", "client": "backend", "operation": "conversations.create",
          "args": { "input": { "title": "Edits ${nonce}", "props": {}, "members": [{ "principalId": "${saved.alice.principalId}", "role": "member" }] } },
          "save": "conversation" },
        { "do": "invoke", "client": "backend", "operation": "sessions.issue",
          "args": { "principalId": "${saved.alice.principalId}", "deviceId": "${uuid.aliceDevice}" }, "save": "aliceSession" },
        { "do": "client.create", "client": "alice", "role": "user", "credential": "${saved.aliceSession.sessionToken}", "principalId": "${saved.alice.principalId}" },
        { "do": "invoke", "client": "alice", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "draft" } },
        { "do": "invoke", "client": "alice", "operation": "messages.list", "args": { "conversationId": "${saved.conversation.conversationId}" }, "save": "page" },
        { "do": "invoke", "client": "alice", "operation": "messages.edit",
          "args": { "message": "${saved.page.items.0}", "text": "final", "requestId": "${uuid.edit}" },
          "expect": { "value": { "revision": "2", "text": "final" } }, "save": "edited" },
        { "do": "invoke", "client": "alice", "operation": "messages.edit",
          "args": { "message": "${saved.page.items.0}", "text": "final", "requestId": "${uuid.edit}" },
          "note": "Same request id and payload, so the stale expected revision is not evaluated again.",
          "expect": { "value": { "messageId": "${saved.edited.messageId}", "revision": "2", "revisionSequence": "${saved.edited.revisionSequence}", "text": "final" } } }
      ]
    },
    {
      "id": "idempotency.conversations.create-replay",
      "title": "Backend conversation creation is idempotent per request id",
      "covers": ["idempotency", "auth.backendKey"],
      "steps": [
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" }, "save": "alice" },
        { "do": "invoke", "client": "backend", "operation": "conversations.create",
          "args": { "input": { "title": "Once ${nonce}", "props": {}, "members": [{ "principalId": "${saved.alice.principalId}", "role": "member" }] }, "requestId": "${uuid.create}" },
          "save": "conversation" },
        { "do": "invoke", "client": "backend", "operation": "conversations.create",
          "args": { "input": { "title": "Once ${nonce}", "props": {}, "members": [{ "principalId": "${saved.alice.principalId}", "role": "member" }] }, "requestId": "${uuid.create}" },
          "expect": { "value": { "conversationId": "${saved.conversation.conversationId}", "revision": "${saved.conversation.revision}" } } },
        { "do": "client.create", "client": "restarted", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "restarted", "operation": "conversations.create",
          "args": { "input": { "title": "Once ${nonce}", "props": {}, "members": [{ "principalId": "${saved.alice.principalId}", "role": "member" }] }, "requestId": "${uuid.create}" },
          "expect": { "value": { "conversationId": "${saved.conversation.conversationId}" } } },
        { "do": "client.create", "client": "other", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "other", "operation": "conversations.create",
          "args": { "input": { "title": "Twice ${nonce}", "props": {}, "members": [{ "principalId": "${saved.alice.principalId}", "role": "member" }] }, "requestId": "${uuid.create}" },
          "note": "A client with no local record of the request gets the service's definitive conflict.",
          "expect": { "error": { "code": "IDEMPOTENCY_CONFLICT", "status": 409, "outcome": "rejected", "requestId": "${uuid.create}" } } },
        { "do": "invoke", "client": "other", "operation": "conversations.get", "args": { "conversationId": "${saved.conversation.conversationId}" },
          "expect": { "value": { "title": "Once ${nonce}" } } }
      ]
    },
    {
      "id": "idempotency.members.add-replay",
      "title": "Replaying a membership batch returns the original memberships instead of a revision conflict",
      "covers": ["idempotency"],
      "steps": [
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" }, "save": "alice" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "bob-${nonce}" }, "save": "bob" },
        { "do": "invoke", "client": "backend", "operation": "conversations.create",
          "args": { "input": { "title": "Batches ${nonce}", "props": {}, "members": [{ "principalId": "${saved.alice.principalId}", "role": "member" }] } },
          "save": "conversation" },
        { "do": "invoke", "client": "backend", "operation": "members.add",
          "args": { "conversationId": "${saved.conversation.conversationId}", "requestId": "${uuid.add}",
            "members": [{ "principalId": "${saved.bob.principalId}", "role": "member", "expectedRevision": "0" }] },
          "expect": { "value": [{ "principalId": "${saved.bob.principalId}", "revision": "1" }] }, "save": "added" },
        { "do": "client.create", "client": "restarted", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "restarted", "operation": "members.add",
          "args": { "conversationId": "${saved.conversation.conversationId}", "requestId": "${uuid.add}",
            "members": [{ "principalId": "${saved.bob.principalId}", "role": "member", "expectedRevision": "0" }] },
          "expect": { "value": [{ "principalId": "${saved.bob.principalId}", "revision": "1", "visibleFromSequence": "${saved.added.0.visibleFromSequence}" }] } },
        { "do": "invoke", "client": "restarted", "operation": "members.list", "args": { "conversationId": "${saved.conversation.conversationId}", "limit": 10 },
          "expect": { "value": { "items": { "$length": 2 } } } }
      ]
    }
  ]
}
