{
  "$schema": "../scenario.schema.json",
  "suite": "realtime",
  "title": "Realtime conversation events",
  "description": "Conversation event streams opened through the SDK's subscribe/watch API: replay then live delivery as one ordered run, agreement between subscribers, visibility for late members, reconnect after a server restart, resume from a persisted cursor and authorization failures. Event type strings are not pinned; events are identified by sequence, subjectRef and payload.",
  "scenarios": [
    {
      "id": "realtime.ordering.replay-then-live",
      "title": "A subscriber receives retained history and then live events as one gap-free, duplicate-free ascending run",
      "covers": ["realtime.ordering", "auth.userToken"],
      "steps": [
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" }, "save": "alice" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "bob-${nonce}" }, "save": "bob" },
        { "do": "invoke", "client": "backend", "operation": "conversations.create",
          "args": { "input": { "title": "Realtime ${nonce}", "props": {}, "members": [{ "principalId": "${saved.alice.principalId}", "role": "member" },
            { "principalId": "${saved.bob.principalId}", "role": "member" }] } }, "save": "conversation" },
        { "do": "invoke", "client": "backend", "operation": "sessions.issue",
          "args": { "principalId": "${saved.alice.principalId}", "deviceId": "${uuid.aliceDevice}" }, "save": "aliceSession" },
        { "do": "invoke", "client": "backend", "operation": "sessions.issue",
          "args": { "principalId": "${saved.bob.principalId}", "deviceId": "${uuid.bobDevice}" }, "save": "bobSession" },
        { "do": "client.create", "client": "alice", "role": "user", "credential": "${saved.aliceSession.sessionToken}", "principalId": "${saved.alice.principalId}" },
        { "do": "client.create", "client": "bob", "role": "user", "credential": "${saved.bobSession.sessionToken}", "principalId": "${saved.bob.principalId}" },
        { "do": "invoke", "client": "bob", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "one" }, "save": "m1" },
        { "do": "invoke", "client": "bob", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "two" }, "save": "m2" },
        { "do": "invoke", "client": "bob", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "three" }, "save": "m3" },
        { "do": "invoke", "client": "alice", "operation": "events.list", "args": { "conversationId": "${saved.conversation.conversationId}" },
          "note": "The first event alice may read. The stream must start from the same place.",
          "expect": { "value": { "items": { "$length": { "$gte": 1 } } } }, "save": "history" },
        { "do": "realtime.subscribe", "client": "alice", "subscription": "aliceEvents", "conversationId": "${saved.conversation.conversationId}" },
        { "do": "realtime.collect", "subscription": "aliceEvents", "until": { "sequence": "${saved.m3.sequence}" },
          "note": "Replay delivers everything already retained, oldest first.",
          "expect": { "events": {
            "$sequences": { "from": "${saved.history.items.0.sequence}", "to": "${saved.m3.sequence}" },
            "$contains": { "eventId": { "$type": "uuid" }, "conversationId": "${saved.conversation.conversationId}", "sequence": "${saved.m1.sequence}",
              "type": { "$type": "string" }, "occurredAt": { "$type": "timestamp" },
              "subjectRef": { "kind": "message", "id": "${saved.m1.messageId}" },
              "payload": { "messageId": "${saved.m1.messageId}", "revision": "1", "revisionSequence": "${saved.m1.sequence}" } } } } },
        { "do": "invoke", "client": "bob", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "four" }, "save": "m4" },
        { "do": "invoke", "client": "bob", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "five" }, "save": "m5" },
        { "do": "realtime.collect", "subscription": "aliceEvents", "until": { "sequence": "${saved.m5.sequence}" },
          "note": "Live events continue the same run with no gaps or repeats.",
          "expect": { "events": {
            "$sequences": { "from": "${saved.history.items.0.sequence}", "to": "${saved.m5.sequence}" },
            "$contains": { "sequence": "${saved.m5.sequence}", "subjectRef": { "kind": "message", "id": "${saved.m5.messageId}" },
              "payload": { "messageId": "${saved.m5.messageId}", "revision": "1" } } } } },
        { "do": "realtime.close", "subscription": "aliceEvents" }
      ]
    },
    {
      "id": "realtime.ordering.subscribers-agree",
      "title": "Two members watching the same conversation see the same events in the same order",
      "covers": ["realtime.ordering"],
      "steps": [
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" }, "save": "alice" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "bob-${nonce}" }, "save": "bob" },
        { "do": "invoke", "client": "backend", "operation": "conversations.create",
          "args": { "input": { "title": "Agreement ${nonce}", "props": {}, "members": [{ "principalId": "${saved.alice.principalId}", "role": "member" },
            { "principalId": "${saved.bob.principalId}", "role": "member" }] } }, "save": "conversation" },
        { "do": "invoke", "client": "backend", "operation": "sessions.issue",
          "args": { "principalId": "${saved.alice.principalId}", "deviceId": "${uuid.aliceDevice}" }, "save": "aliceSession" },
        { "do": "invoke", "client": "backend", "operation": "sessions.issue",
          "args": { "principalId": "${saved.bob.principalId}", "deviceId": "${uuid.bobDevice}" }, "save": "bobSession" },
        { "do": "client.create", "client": "alice", "role": "user", "credential": "${saved.aliceSession.sessionToken}", "principalId": "${saved.alice.principalId}" },
        { "do": "client.create", "client": "bob", "role": "user", "credential": "${saved.bobSession.sessionToken}", "principalId": "${saved.bob.principalId}" },
        { "do": "invoke", "client": "alice", "operation": "events.list", "args": { "conversationId": "${saved.conversation.conversationId}" },
          "expect": { "value": { "items": { "$length": { "$gte": 1 } } } }, "save": "aliceHistory" },
        { "do": "invoke", "client": "bob", "operation": "events.list", "args": { "conversationId": "${saved.conversation.conversationId}" },
          "expect": { "value": { "items": { "$length": { "$gte": 1 } } } }, "save": "bobHistory" },
        { "do": "realtime.subscribe", "client": "alice", "subscription": "aliceEvents", "conversationId": "${saved.conversation.conversationId}" },
        { "do": "realtime.subscribe", "client": "bob", "subscription": "bobEvents", "conversationId": "${saved.conversation.conversationId}" },
        { "do": "invoke", "client": "alice", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "a1" }, "save": "m1" },
        { "do": "invoke", "client": "bob", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "b1" }, "save": "m2" },
        { "do": "invoke", "client": "alice", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "a2" }, "save": "m3" },
        { "do": "invoke", "client": "bob", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "b2" }, "save": "m4" },
        { "do": "realtime.collect", "subscription": "aliceEvents", "until": { "sequence": "${saved.m4.sequence}" },
          "note": "Authors receive their own messages as events too.",
          "expect": { "events": {
            "$sequences": { "from": "${saved.aliceHistory.items.0.sequence}", "to": "${saved.m4.sequence}" },
            "$contains": { "sequence": "${saved.m2.sequence}", "subjectRef": { "kind": "message", "id": "${saved.m2.messageId}" } } } } },
        { "do": "realtime.collect", "subscription": "bobEvents", "until": { "sequence": "${saved.m4.sequence}" },
          "expect": { "events": {
            "$sequences": { "from": "${saved.bobHistory.items.0.sequence}", "to": "${saved.m4.sequence}" },
            "$contains": { "sequence": "${saved.m3.sequence}", "subjectRef": { "kind": "message", "id": "${saved.m3.messageId}" } } } } },
        { "do": "realtime.close", "subscription": "aliceEvents" },
        { "do": "realtime.close", "subscription": "bobEvents" }
      ]
    },
    {
      "id": "realtime.ordering.message-revisions",
      "title": "Edits and deletes arrive as new events carrying the message's new revision",
      "covers": ["realtime.ordering", "crud"],
      "steps": [
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" }, "save": "alice" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "bob-${nonce}" }, "save": "bob" },
        { "do": "invoke", "client": "backend", "operation": "conversations.create",
          "args": { "input": { "title": "Revisions ${nonce}", "props": {}, "members": [{ "principalId": "${saved.alice.principalId}", "role": "member" },
            { "principalId": "${saved.bob.principalId}", "role": "member" }] } }, "save": "conversation" },
        { "do": "invoke", "client": "backend", "operation": "sessions.issue",
          "args": { "principalId": "${saved.alice.principalId}", "deviceId": "${uuid.aliceDevice}" }, "save": "aliceSession" },
        { "do": "invoke", "client": "backend", "operation": "sessions.issue",
          "args": { "principalId": "${saved.bob.principalId}", "deviceId": "${uuid.bobDevice}" }, "save": "bobSession" },
        { "do": "client.create", "client": "alice", "role": "user", "credential": "${saved.aliceSession.sessionToken}", "principalId": "${saved.alice.principalId}" },
        { "do": "client.create", "client": "bob", "role": "user", "credential": "${saved.bobSession.sessionToken}", "principalId": "${saved.bob.principalId}" },
        { "do": "invoke", "client": "alice", "operation": "events.list", "args": { "conversationId": "${saved.conversation.conversationId}" },
          "expect": { "value": { "items": { "$length": { "$gte": 1 } } } }, "save": "history" },
        { "do": "realtime.subscribe", "client": "alice", "subscription": "aliceEvents", "conversationId": "${saved.conversation.conversationId}" },
        { "do": "invoke", "client": "bob", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "draft" }, "save": "m1" },
        { "do": "realtime.collect", "subscription": "aliceEvents", "until": { "sequence": "${saved.m1.sequence}" },
          "expect": { "events": { "$contains": { "sequence": "${saved.m1.sequence}", "subjectRef": { "kind": "message", "id": "${saved.m1.messageId}" },
            "payload": { "messageId": "${saved.m1.messageId}", "revision": "1", "revisionSequence": "${saved.m1.sequence}" } } } } },
        { "do": "invoke", "client": "bob", "operation": "messages.list", "args": { "conversationId": "${saved.conversation.conversationId}" }, "save": "page" },
        { "do": "invoke", "client": "bob", "operation": "messages.edit", "args": { "message": "${saved.page.items.0}", "text": "final" },
          "expect": { "value": { "messageId": "${saved.m1.messageId}", "revision": "2" } }, "save": "edited" },
        { "do": "realtime.collect", "subscription": "aliceEvents", "until": { "sequence": "${saved.edited.revisionSequence}" },
          "note": "The edit is a new event at the message's revisionSequence; the original event is not rewritten.",
          "expect": { "events": {
            "$sequences": { "from": "${saved.history.items.0.sequence}", "to": "${saved.edited.revisionSequence}" },
            "$contains": { "sequence": "${saved.edited.revisionSequence}", "subjectRef": { "kind": "message", "id": "${saved.m1.messageId}" },
              "payload": { "messageId": "${saved.m1.messageId}", "revision": "2", "revisionSequence": "${saved.edited.revisionSequence}" } } } } },
        { "do": "invoke", "client": "bob", "operation": "messages.delete", "args": { "message": "${saved.edited}" },
          "expect": { "value": { "messageId": "${saved.m1.messageId}", "revision": "3", "deleted": true } }, "save": "deleted" },
        { "do": "realtime.collect", "subscription": "aliceEvents", "until": { "sequence": "${saved.deleted.revisionSequence}" },
          "expect": { "events": {
            "$sequences": { "from": "${saved.history.items.0.sequence}", "to": "${saved.deleted.revisionSequence}" },
            "$contains": { "sequence": "${saved.deleted.revisionSequence}", "subjectRef": { "kind": "message", "id": "${saved.m1.messageId}" },
              "payload": { "messageId": "${saved.m1.messageId}", "revision": "3", "revisionSequence": "${saved.deleted.revisionSequence}" } } } } },
        { "do": "realtime.close", "subscription": "aliceEvents" }
      ]
    },
    {
      "id": "realtime.ordering.late-member-visibility",
      "title": "A member added later receives no events from before it joined",
      "covers": ["realtime.ordering", "auth.scopes"],
      "steps": [
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" }, "save": "alice" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "carol-${nonce}" }, "save": "carol" },
        { "do": "invoke", "client": "backend", "operation": "conversations.create",
          "args": { "input": { "title": "Late joiner ${nonce}", "props": {}, "members": [{ "principalId": "${saved.alice.principalId}", "role": "member" }] } },
          "save": "conversation" },
        { "do": "invoke", "client": "backend", "operation": "sessions.issue",
          "args": { "principalId": "${saved.alice.principalId}", "deviceId": "${uuid.aliceDevice}" }, "save": "aliceSession" },
        { "do": "client.create", "client": "alice", "role": "user", "credential": "${saved.aliceSession.sessionToken}", "principalId": "${saved.alice.principalId}" },
        { "do": "invoke", "client": "alice", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "before carol" }, "save": "m1" },
        { "do": "invoke", "client": "alice", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "still before carol" }, "save": "m2" },
        { "do": "invoke", "client": "backend", "operation": "members.add",
          "args": { "conversationId": "${saved.conversation.conversationId}",
            "members": [{ "principalId": "${saved.carol.principalId}", "role": "member", "expectedRevision": "0" }] },
          "expect": { "value": [{ "principalId": "${saved.carol.principalId}", "status": "active",
            "visibleFromSequence": { "$gte": "${saved.m2.sequence}", "$ne": "${saved.m2.sequence}" } }] },
          "save": "carolJoined" },
        { "do": "invoke", "client": "alice", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "welcome carol" }, "save": "m3" },
        { "do": "invoke", "client": "backend", "operation": "sessions.issue",
          "args": { "principalId": "${saved.carol.principalId}", "deviceId": "${uuid.carolDevice}" }, "save": "carolSession" },
        { "do": "client.create", "client": "carol", "role": "user", "credential": "${saved.carolSession.sessionToken}", "principalId": "${saved.carol.principalId}" },
        { "do": "invoke", "client": "carol", "operation": "events.list", "args": { "conversationId": "${saved.conversation.conversationId}" },
          "expect": { "value": { "items": { "$length": { "$gte": 1 },
            "$each": { "sequence": { "$gte": "${saved.carolJoined.0.visibleFromSequence}" } } } } },
          "save": "carolHistory" },
        { "do": "realtime.subscribe", "client": "carol", "subscription": "carolEvents", "conversationId": "${saved.conversation.conversationId}" },
        { "do": "realtime.collect", "subscription": "carolEvents", "until": { "sequence": "${saved.m3.sequence}" },
          "note": "The stream starts where carol's readable history starts, which is never before visibleFromSequence.",
          "expect": { "events": {
            "$sequences": { "from": "${saved.carolHistory.items.0.sequence}", "to": "${saved.m3.sequence}" },
            "$contains": { "sequence": "${saved.m3.sequence}", "subjectRef": { "kind": "message", "id": "${saved.m3.messageId}" } } } } },
        { "do": "realtime.close", "subscription": "carolEvents" }
      ]
    },
    {
      "id": "realtime.reconnect.server-restart",
      "title": "After a server restart the SDK resubscribes on its own from its cursor and misses nothing sent while it was away",
      "description": "The target closes the socket with 1012 (service restart). Events sent while disconnected must be delivered once, in order, and the new subscription must resume after the last applied event rather than replay from the start.",
      "covers": ["realtime.reconnect", "realtime.resume", "realtime.ordering"],
      "steps": [
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" }, "save": "alice" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "bob-${nonce}" }, "save": "bob" },
        { "do": "invoke", "client": "backend", "operation": "conversations.create",
          "args": { "input": { "title": "Restart ${nonce}", "props": {}, "members": [{ "principalId": "${saved.alice.principalId}", "role": "member" },
            { "principalId": "${saved.bob.principalId}", "role": "member" }] } }, "save": "conversation" },
        { "do": "invoke", "client": "backend", "operation": "sessions.issue",
          "args": { "principalId": "${saved.alice.principalId}", "deviceId": "${uuid.aliceDevice}" }, "save": "aliceSession" },
        { "do": "invoke", "client": "backend", "operation": "sessions.issue",
          "args": { "principalId": "${saved.bob.principalId}", "deviceId": "${uuid.bobDevice}" }, "save": "bobSession" },
        { "do": "client.create", "client": "alice", "role": "user", "credential": "${saved.aliceSession.sessionToken}", "principalId": "${saved.alice.principalId}" },
        { "do": "client.create", "client": "bob", "role": "user", "credential": "${saved.bobSession.sessionToken}", "principalId": "${saved.bob.principalId}" },
        { "do": "invoke", "client": "alice", "operation": "events.list", "args": { "conversationId": "${saved.conversation.conversationId}" },
          "expect": { "value": { "items": { "$length": { "$gte": 1 } } } }, "save": "history" },
        { "do": "realtime.subscribe", "client": "alice", "subscription": "aliceEvents", "conversationId": "${saved.conversation.conversationId}" },
        { "do": "control.waitLog", "kind": "subscribe",
          "match": { "conversationId": "${saved.conversation.conversationId}", "principalId": "${saved.alice.principalId}" },
          "note": "Wait until the realtime subscription is registered so the restart hits a live socket." },
        { "do": "invoke", "client": "bob", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "before restart" }, "save": "m1" },
        { "do": "realtime.collect", "subscription": "aliceEvents", "until": { "sequence": "${saved.m1.sequence}" },
          "expect": { "events": { "$contains": { "sequence": "${saved.m1.sequence}", "subjectRef": { "kind": "message", "id": "${saved.m1.messageId}" } } } } },
        { "do": "control.realtimeDrop", "conversationId": "${saved.conversation.conversationId}", "code": 1012, "reason": "Service restart",
          "expect": { "closed": { "$gte": 1 } } },
        { "do": "invoke", "client": "bob", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "while away 1" }, "save": "m2" },
        { "do": "invoke", "client": "bob", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "while away 2" }, "save": "m3" },
        { "do": "control.waitLog", "kind": "subscribe", "count": 2, "timeoutMs": 15000,
          "match": { "conversationId": "${saved.conversation.conversationId}", "principalId": "${saved.alice.principalId}" },
          "note": "No application call is involved: the SDK reconnects by itself and subscribes after the last event it applied.",
          "expect": { "$contains": { "after": { "$gte": "${saved.m1.sequence}" } } } },
        { "do": "invoke", "client": "bob", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "after restart" }, "save": "m4" },
        { "do": "realtime.collect", "subscription": "aliceEvents", "until": { "sequence": "${saved.m4.sequence}" }, "timeoutMs": 15000,
          "note": "SDKs may report transient errors while reconnecting, but the stream must stay open.",
          "expect": { "errors": { "$type": "array" }, "events": {
            "$sequences": { "from": "${saved.history.items.0.sequence}", "to": "${saved.m4.sequence}" },
            "$contains": { "sequence": "${saved.m4.sequence}", "subjectRef": { "kind": "message", "id": "${saved.m4.messageId}" } } } } },
        { "do": "realtime.close", "subscription": "aliceEvents" }
      ]
    },
    {
      "id": "realtime.reconnect.authorization-ended",
      "title": "When the server ends a subscription's authorization the stream closes with UNAUTHENTICATED and does not reconnect",
      "description": "The target closes the socket with graphql-transport-ws 4401, as it does when a session expires or is revoked. Reconnecting with the same credential would only fail again.",
      "covers": ["realtime.reconnect", "auth.userToken", "errors"],
      "steps": [
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" }, "save": "alice" },
        { "do": "invoke", "client": "backend", "operation": "conversations.create",
          "args": { "input": { "title": "Revoked ${nonce}", "props": {}, "members": [{ "principalId": "${saved.alice.principalId}", "role": "member" }] } },
          "save": "conversation" },
        { "do": "invoke", "client": "backend", "operation": "sessions.issue",
          "args": { "principalId": "${saved.alice.principalId}", "deviceId": "${uuid.aliceDevice}" }, "save": "aliceSession" },
        { "do": "client.create", "client": "alice", "role": "user", "credential": "${saved.aliceSession.sessionToken}", "principalId": "${saved.alice.principalId}" },
        { "do": "realtime.subscribe", "client": "alice", "subscription": "aliceEvents", "conversationId": "${saved.conversation.conversationId}" },
        { "do": "control.waitLog", "kind": "subscribe",
          "match": { "conversationId": "${saved.conversation.conversationId}", "principalId": "${saved.alice.principalId}" } },
        { "do": "control.realtimeDrop", "conversationId": "${saved.conversation.conversationId}", "code": 4401, "reason": "Unauthorized",
          "expect": { "closed": { "$gte": 1 } } },
        { "do": "realtime.collect", "subscription": "aliceEvents", "until": { "closed": true }, "timeoutMs": 5000,
          "expect": { "errors": { "$contains": { "code": "UNAUTHENTICATED", "status": 401 } } } },
        { "do": "sleep", "ms": 3000, "note": "Longer than any first reconnect delay." },
        { "do": "control.waitLog", "kind": "subscribe",
          "match": { "conversationId": "${saved.conversation.conversationId}", "principalId": "${saved.alice.principalId}" },
          "note": "Still exactly one subscription: the SDK did not retry with the rejected credential.",
          "expect": { "$length": 1 } }
      ]
    },
    {
      "id": "realtime.resume.stored-cursor",
      "title": "A restarted client with the same storage resumes after its persisted cursor",
      "description": "Only events after the last applied cursor are delivered after a restart; nothing already applied is replayed.",
      "covers": ["realtime.resume"],
      "steps": [
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" }, "save": "alice" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "bob-${nonce}" }, "save": "bob" },
        { "do": "invoke", "client": "backend", "operation": "conversations.create",
          "args": { "input": { "title": "Resume ${nonce}", "props": {}, "members": [{ "principalId": "${saved.alice.principalId}", "role": "member" },
            { "principalId": "${saved.bob.principalId}", "role": "member" }] } }, "save": "conversation" },
        { "do": "invoke", "client": "backend", "operation": "sessions.issue",
          "args": { "principalId": "${saved.alice.principalId}", "deviceId": "${uuid.aliceDevice}" }, "save": "aliceSession" },
        { "do": "invoke", "client": "backend", "operation": "sessions.issue",
          "args": { "principalId": "${saved.bob.principalId}", "deviceId": "${uuid.bobDevice}" }, "save": "bobSession" },
        { "do": "client.create", "client": "alice1", "role": "user", "credential": "${saved.aliceSession.sessionToken}", "principalId": "${saved.alice.principalId}",
          "storage": "aliceDevice" },
        { "do": "client.create", "client": "bob", "role": "user", "credential": "${saved.bobSession.sessionToken}", "principalId": "${saved.bob.principalId}" },
        { "do": "invoke", "client": "alice1", "operation": "events.list", "args": { "conversationId": "${saved.conversation.conversationId}" },
          "expect": { "value": { "items": { "$length": { "$gte": 1 } } } }, "save": "history" },
        { "do": "realtime.subscribe", "client": "alice1", "subscription": "first", "conversationId": "${saved.conversation.conversationId}" },
        { "do": "invoke", "client": "bob", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "one" }, "save": "m1" },
        { "do": "invoke", "client": "bob", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "two" }, "save": "m2" },
        { "do": "realtime.collect", "subscription": "first", "until": { "sequence": "${saved.m2.sequence}" },
          "expect": { "events": { "$sequences": { "from": "${saved.history.items.0.sequence}", "to": "${saved.m2.sequence}" } } } },
        { "do": "realtime.close", "subscription": "first" },
        { "do": "client.close", "client": "alice1" },
        { "do": "invoke", "client": "bob", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "three" }, "save": "m3" },
        { "do": "invoke", "client": "bob", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "four" }, "save": "m4" },
        { "do": "client.create", "client": "alice2", "role": "user", "credential": "${saved.aliceSession.sessionToken}", "principalId": "${saved.alice.principalId}",
          "storage": "aliceDevice" },
        { "do": "realtime.subscribe", "client": "alice2", "subscription": "second", "conversationId": "${saved.conversation.conversationId}" },
        { "do": "realtime.collect", "subscription": "second", "until": { "sequence": "${saved.m4.sequence}" },
          "expect": { "events": [
            { "sequence": "${saved.m3.sequence}", "subjectRef": { "kind": "message", "id": "${saved.m3.messageId}" } },
            { "sequence": "${saved.m4.sequence}", "subjectRef": { "kind": "message", "id": "${saved.m4.messageId}" } }] } },
        { "do": "realtime.close", "subscription": "second" }
      ]
    },
    {
      "id": "realtime.subscribe.non-member",
      "title": "Subscribing to a conversation the principal is not a member of fails as NOT_FOUND",
      "covers": ["auth.userToken", "auth.scopes", "errors"],
      "steps": [
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" }, "save": "alice" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "carol-${nonce}" }, "save": "carol" },
        { "do": "invoke", "client": "backend", "operation": "conversations.create",
          "args": { "input": { "title": "Private ${nonce}", "props": {}, "members": [{ "principalId": "${saved.alice.principalId}", "role": "member" }] } },
          "save": "conversation" },
        { "do": "invoke", "client": "backend", "operation": "sessions.issue",
          "args": { "principalId": "${saved.carol.principalId}", "deviceId": "${uuid.carolDevice}" }, "save": "carolSession" },
        { "do": "client.create", "client": "carol", "role": "user", "credential": "${saved.carolSession.sessionToken}", "principalId": "${saved.carol.principalId}" },
        { "do": "realtime.subscribe", "client": "carol", "subscription": "carolEvents", "conversationId": "${saved.conversation.conversationId}",
          "note": "Existence is not disclosed to non-members.",
          "expect": { "error": { "code": "NOT_FOUND", "status": 404, "outcome": "rejected" } } }
      ]
    },
    {
      "id": "realtime.subscribe.invalid-token",
      "title": "Subscribing with an invalid session token fails as UNAUTHENTICATED",
      "covers": ["auth.userToken", "errors"],
      "steps": [
        { "do": "client.create", "client": "alice", "role": "user", "credential": "invalid-session-token-${nonce}", "principalId": "${uuid.alice}" },
        { "do": "realtime.subscribe", "client": "alice", "subscription": "aliceEvents", "conversationId": "${uuid.conversation}",
          "expect": { "error": { "code": "UNAUTHENTICATED", "status": 401, "outcome": "rejected" } } }
      ]
    }
  ]
}
