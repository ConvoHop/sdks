{
  "$schema": "../scenario.schema.json",
  "suite": "pagination",
  "title": "Pagination",
  "description": "Member, message and event pages: limits, cursors, completion flags and stable order across pages.",
  "scenarios": [
    {
      "id": "pagination.members.limit-and-cursor",
      "title": "Member pages honour the limit and the cursor continues where the previous page ended",
      "description": "Pages are compared with a single full listing, so the scenario does not depend on which stable order the target uses.",
      "covers": ["pagination"],
      "steps": [
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" }, "save": "alice" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "bob-${nonce}" }, "save": "bob" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "carol-${nonce}" }, "save": "carol" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "dave-${nonce}" }, "save": "dave" },
        { "do": "invoke", "client": "backend", "operation": "conversations.create",
          "args": { "input": { "title": "Pages ${nonce}", "props": {}, "members": [
            { "principalId": "${saved.alice.principalId}", "role": "member" }, { "principalId": "${saved.bob.principalId}", "role": "member" },
            { "principalId": "${saved.carol.principalId}", "role": "member" }, { "principalId": "${saved.dave.principalId}", "role": "member" }] } },
          "save": "conversation" },
        { "do": "invoke", "client": "backend", "operation": "members.list", "args": { "conversationId": "${saved.conversation.conversationId}", "limit": 10 },
          "expect": { "value": { "complete": true, "nextCursor": null, "items": { "$length": 4 } } }, "save": "all" },
        { "do": "invoke", "client": "backend", "operation": "members.list", "args": { "conversationId": "${saved.conversation.conversationId}", "limit": 2 },
          "expect": { "value": { "complete": false, "nextCursor": { "$type": "string" },
            "items": [{ "principalId": "${saved.all.items.0.principalId}" }, { "principalId": "${saved.all.items.1.principalId}" }] } },
          "save": "first" },
        { "do": "invoke", "client": "backend", "operation": "members.list",
          "args": { "conversationId": "${saved.conversation.conversationId}", "limit": 3, "cursor": "${saved.first.nextCursor}" },
          "note": "Fewer items than the limit remain, so this page is the last one.",
          "expect": { "value": { "complete": true, "nextCursor": null,
            "items": [{ "principalId": "${saved.all.items.2.principalId}" }, { "principalId": "${saved.all.items.3.principalId}" }] } } },
        { "do": "invoke", "client": "backend", "operation": "members.list", "args": { "conversationId": "${saved.conversation.conversationId}", "limit": 1 },
          "expect": { "value": { "complete": false, "items": [{ "principalId": "${saved.all.items.0.principalId}" }] } } }
      ]
    },
    {
      "id": "pagination.messages.newest-first",
      "title": "Message history pages run newest first and continue before the oldest sequence seen",
      "description": "The target caps message pages at three items (capability pagination.serverCappedPages).",
      "covers": ["pagination"],
      "requires": { "capabilities": ["pagination.serverCappedPages"] },
      "steps": [
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" }, "save": "alice" },
        { "do": "invoke", "client": "backend", "operation": "conversations.create",
          "args": { "input": { "title": "History ${nonce}", "props": {}, "members": [{ "principalId": "${saved.alice.principalId}", "role": "member" }] } },
          "save": "conversation" },
        { "do": "invoke", "client": "backend", "operation": "sessions.issue",
          "args": { "principalId": "${saved.alice.principalId}", "deviceId": "${uuid.aliceDevice}" }, "save": "aliceSession" },
        { "do": "client.create", "client": "alice", "role": "user", "credential": "${saved.aliceSession.sessionToken}", "principalId": "${saved.alice.principalId}" },
        { "do": "invoke", "client": "alice", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "one" }, "save": "m1" },
        { "do": "invoke", "client": "alice", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "two" }, "save": "m2" },
        { "do": "invoke", "client": "alice", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "three" }, "save": "m3" },
        { "do": "invoke", "client": "alice", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "four" }, "save": "m4" },
        { "do": "invoke", "client": "alice", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "five" }, "save": "m5" },
        { "do": "invoke", "client": "alice", "operation": "messages.list", "args": { "conversationId": "${saved.conversation.conversationId}" },
          "expect": { "value": { "complete": false, "nextCursor": { "$type": "string" }, "items": [
            { "messageId": "${saved.m5.messageId}", "sequence": "${saved.m5.sequence}", "text": "five" },
            { "messageId": "${saved.m4.messageId}", "sequence": "${saved.m4.sequence}", "text": "four" },
            { "messageId": "${saved.m3.messageId}", "sequence": "${saved.m3.sequence}", "text": "three" }] } },
          "save": "newest" },
        { "do": "invoke", "client": "alice", "operation": "messages.list",
          "args": { "conversationId": "${saved.conversation.conversationId}", "beforeSequence": "${saved.newest.items.2.sequence}" },
          "expect": { "value": { "complete": true, "nextCursor": null, "items": [
            { "messageId": "${saved.m2.messageId}", "sequence": "${saved.m2.sequence}", "text": "two" },
            { "messageId": "${saved.m1.messageId}", "sequence": "${saved.m1.sequence}", "text": "one" }] } } },
        { "do": "invoke", "client": "alice", "operation": "messages.list",
          "args": { "conversationId": "${saved.conversation.conversationId}", "beforeSequence": "${saved.m1.sequence}" },
          "expect": { "value": { "complete": true, "nextCursor": null, "items": [] } } }
      ]
    },
    {
      "id": "pagination.events.after-cursor",
      "title": "Event pages run oldest first from an exclusive cursor and an exhausted page does not move the cursor back",
      "description": "The target caps event pages at three items (capability pagination.serverCappedPages).",
      "covers": ["pagination", "realtime.ordering"],
      "requires": { "capabilities": ["pagination.serverCappedPages"] },
      "steps": [
        { "do": "client.create", "client": "backend", "role": "backend", "credential": "${target.credentials.backend}" },
        { "do": "invoke", "client": "backend", "operation": "principals.create", "args": { "externalUserId": "alice-${nonce}" }, "save": "alice" },
        { "do": "invoke", "client": "backend", "operation": "conversations.create",
          "args": { "input": { "title": "Events ${nonce}", "props": {}, "members": [{ "principalId": "${saved.alice.principalId}", "role": "member" }] } },
          "save": "conversation" },
        { "do": "invoke", "client": "backend", "operation": "sessions.issue",
          "args": { "principalId": "${saved.alice.principalId}", "deviceId": "${uuid.aliceDevice}" }, "save": "aliceSession" },
        { "do": "client.create", "client": "alice", "role": "user", "credential": "${saved.aliceSession.sessionToken}", "principalId": "${saved.alice.principalId}" },
        { "do": "invoke", "client": "alice", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "one" }, "save": "m1" },
        { "do": "invoke", "client": "alice", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "two" }, "save": "m2" },
        { "do": "invoke", "client": "alice", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "three" }, "save": "m3" },
        { "do": "invoke", "client": "alice", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "four" }, "save": "m4" },
        { "do": "invoke", "client": "alice", "operation": "messages.send", "args": { "conversationId": "${saved.conversation.conversationId}", "text": "five" }, "save": "m5" },
        { "do": "invoke", "client": "alice", "operation": "events.list",
          "args": { "conversationId": "${saved.conversation.conversationId}", "after": "${saved.m1.cursor}" },
          "note": "The send acknowledgement's cursor is exclusive: the page starts after m1.",
          "expect": { "value": { "complete": false,
            "nextCursor": { "incarnation": "${target.incarnation}", "conversationId": "${saved.conversation.conversationId}", "sequence": "${saved.m4.sequence}" },
            "items": [
              { "conversationId": "${saved.conversation.conversationId}", "sequence": "${saved.m2.sequence}", "subjectRef": { "kind": "message", "id": "${saved.m2.messageId}" } },
              { "conversationId": "${saved.conversation.conversationId}", "sequence": "${saved.m3.sequence}", "subjectRef": { "kind": "message", "id": "${saved.m3.messageId}" } },
              { "conversationId": "${saved.conversation.conversationId}", "sequence": "${saved.m4.sequence}", "subjectRef": { "kind": "message", "id": "${saved.m4.messageId}" } }] } },
          "save": "first" },
        { "do": "invoke", "client": "alice", "operation": "events.list",
          "args": { "conversationId": "${saved.conversation.conversationId}", "after": "${saved.first.nextCursor}" },
          "expect": { "value": { "complete": true, "nextCursor": { "sequence": "${saved.m5.sequence}" },
            "items": [{ "sequence": "${saved.m5.sequence}", "subjectRef": { "kind": "message", "id": "${saved.m5.messageId}" },
              "payload": { "messageId": "${saved.m5.messageId}", "revision": "1" } }] } },
          "save": "second" },
        { "do": "invoke", "client": "alice", "operation": "events.list",
          "args": { "conversationId": "${saved.conversation.conversationId}", "after": "${saved.second.nextCursor}" },
          "note": "A caught-up page may return the same cursor or none, but never an earlier one.",
          "expect": { "value": { "complete": true, "items": [], "nextCursor": { "$anyOf": [null, { "sequence": "${saved.m5.sequence}" }] } } } }
      ]
    }
  ]
}
