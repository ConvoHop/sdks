{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConvoHop SDK documentation manifest",
  "description": "Generated by docgen: docs/site/manifest.json. Navigation and metadata for every page under docs/site. Paths are relative to docs/site. See docs/docs-pipeline.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "title", "description", "topics", "languages", "operations", "llms", "pages"],
  "properties": {
    "$schema": { "const": "../../spec/docs/manifest.schema.json" },
    "title": { "$ref": "#/$defs/text" },
    "description": { "$ref": "#/$defs/text" },
    "topics": {
      "type": "array",
      "items": { "$ref": "#/$defs/topic" },
      "description": "Quickstart topics in navigation order."
    },
    "languages": {
      "type": "array",
      "items": { "$ref": "#/$defs/language" },
      "description": "Languages in navigation order."
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "data"],
      "properties": {
        "index": { "$ref": "#/$defs/path", "description": "The operation reference index page." },
        "data": { "$ref": "#/$defs/path", "description": "operation-index.schema.json data." }
      }
    },
    "llms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "full"],
      "properties": {
        "index": { "$ref": "#/$defs/path", "description": "llms.txt: a link list, per llmstxt.org." },
        "full": { "$ref": "#/$defs/path", "description": "llms-full.txt: every page in one file." }
      }
    },
    "pages": {
      "type": "array",
      "items": { "$ref": "#/$defs/page" },
      "description": "Every Markdown page except README.md, in reading order."
    }
  },
  "$defs": {
    "id": { "type": "string", "maxLength": 32, "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "text": { "type": "string", "minLength": 1, "pattern": "^[^\\n]+$", "description": "Plain text." },
    "path": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_@+=,-][A-Za-z0-9_.@+=,-]*(/[A-Za-z0-9_@+=,-][A-Za-z0-9_.@+=,-]*)*$"
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "summary": { "$ref": "#/$defs/text" }
      }
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "status", "codeFence", "home", "reference", "coverage", "llmsFull", "packages", "quickstarts"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "status": { "enum": ["preview", "stable"] },
        "codeFence": { "type": "string", "pattern": "^[a-z][a-z0-9+#-]*$" },
        "home": { "$ref": "#/$defs/path" },
        "reference": { "$ref": "#/$defs/path", "description": "The language's reference index page." },
        "coverage": { "$ref": "#/$defs/path", "description": "Which SDK members send each operation." },
        "llmsFull": { "$ref": "#/$defs/path", "description": "Every page of the language in one file." },
        "packages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "slug", "layer", "summary", "runtime", "source", "reference", "data"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "slug": { "$ref": "#/$defs/id" },
              "layer": { "enum": ["server", "client"] },
              "summary": { "$ref": "#/$defs/text" },
              "runtime": { "$ref": "#/$defs/text" },
              "source": { "$ref": "#/$defs/path", "description": "Source directory, relative to the repository root." },
              "reference": { "$ref": "#/$defs/path" },
              "data": { "$ref": "#/$defs/path", "description": "reference.schema.json data." }
            }
          }
        },
        "quickstarts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["topic", "path"],
            "properties": {
              "topic": { "$ref": "#/$defs/id" },
              "path": { "$ref": "#/$defs/path" }
            }
          }
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "title", "description"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "kind": {
          "enum": ["home", "language", "quickstart", "reference-index", "reference", "coverage", "operation-index", "operation"]
        },
        "title": { "$ref": "#/$defs/text", "description": "The page's H1 as plain text." },
        "description": { "$ref": "#/$defs/text", "description": "The page's first paragraph as plain text." },
        "language": { "$ref": "#/$defs/id" },
        "topic": { "$ref": "#/$defs/id" },
        "package": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*\\.[a-z][A-Za-z0-9]*$" }
      }
    }
  }
}
