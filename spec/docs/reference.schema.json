{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConvoHop SDK package reference data",
  "description": "Generated by docgen: docs/site/<language>/reference/<slug>.json, the data behind <slug>.md. Links are relative to this file. See docs/docs-pipeline.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "language", "package", "layer", "page", "symbols"],
  "properties": {
    "$schema": { "const": "../../../../spec/docs/reference.schema.json" },
    "language": { "type": "string", "maxLength": 32, "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "package": { "type": "string", "minLength": 1 },
    "layer": { "enum": ["server", "client"] },
    "page": { "$ref": "#/$defs/link", "description": "The Markdown page that renders this data." },
    "symbols": { "type": "array", "items": { "$ref": "#/$defs/symbol" } }
  },
  "$defs": {
    "link": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s/#][^\\s#]*\\.md(#[a-z0-9_-]+)?$"
    },
    "name": { "type": "string", "minLength": 1, "pattern": "^[^\\n`]+$" },
    "anchor": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9_-]+$",
      "description": "The page's heading ID, as GitHub and rehype-slug derive it."
    },
    "ref": {
      "type": "string",
      "minLength": 3,
      "description": "<package>#<Symbol>[.<member>...] with :static after static member names; operation maps and the operation index use the same references."
    },
    "signatures": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "docs": {
      "type": "string",
      "description": "The documentation comment as the page shows it: MDX-safe Markdown whose headings are bold paragraphs. Empty when there's none."
    },
    "deprecated": {
      "type": "string",
      "description": "Present when deprecated: the reason or replacement, rendered like docs and possibly empty."
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "page"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*\\.[a-z][A-Za-z0-9]*$" },
        "page": { "$ref": "#/$defs/link" }
      }
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "ref", "anchor", "signatures", "docs"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "kind": { "enum": ["class", "struct", "interface", "enum", "type", "function", "constant", "namespace"] },
        "ref": { "$ref": "#/$defs/ref" },
        "anchor": { "$ref": "#/$defs/anchor" },
        "signatures": { "$ref": "#/$defs/signatures" },
        "docs": { "$ref": "#/$defs/docs" },
        "deprecated": { "$ref": "#/$defs/deprecated" },
        "origin": { "type": "string", "minLength": 1 },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/operation" },
          "description": "Operations this symbol sends, from the language's operation map."
        },
        "members": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/member" } }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "ref", "anchor", "signatures", "docs"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "kind": { "enum": ["constructor", "method", "property", "case", "call", "index"] },
        "ref": { "$ref": "#/$defs/ref" },
        "anchor": { "$ref": "#/$defs/anchor" },
        "signatures": { "$ref": "#/$defs/signatures" },
        "docs": { "$ref": "#/$defs/docs" },
        "deprecated": { "$ref": "#/$defs/deprecated" },
        "static": { "const": true },
        "inherited": { "$ref": "#/$defs/name" },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/operation" },
          "description": "Operations this member sends, from the language's operation map."
        },
        "members": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/member" } }
      }
    }
  }
}
