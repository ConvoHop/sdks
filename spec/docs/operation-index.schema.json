{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConvoHop operation index",
  "description": "Generated by docgen: docs/site/operations/index.json. Every operation in schema/ir.json, with its page and, for each language, the SDK members that send it. An empty list means the language doesn't wrap the operation. Links are relative to this file. See docs/docs-pipeline.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "operations"],
  "properties": {
    "$schema": { "const": "../../../spec/docs/operation-index.schema.json" },
    "operations": { "type": "array", "items": { "$ref": "#/$defs/operation" } }
  },
  "$defs": {
    "link": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s/#][^\\s#]*\\.md(#[a-z0-9_-]+)?$"
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "plane", "kind", "field", "operationName", "layer", "summary", "page", "languages"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*\\.[a-z][A-Za-z0-9]*$" },
        "plane": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "kind": { "enum": ["query", "mutation", "subscription"] },
        "field": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "operationName": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "layer": { "enum": ["client", "server", "both"] },
        "summary": { "type": "string", "minLength": 1 },
        "page": { "$ref": "#/$defs/link" },
        "languages": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
          "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/member" } }
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "package", "page"],
      "properties": {
        "ref": { "type": "string", "minLength": 3 },
        "package": { "type": "string", "minLength": 1 },
        "page": { "$ref": "#/$defs/link", "description": "The member's heading on its package reference page." }
      }
    }
  }
}
