    {
      "name": "NotificationKind",
      "kind": "type",
      "ref": "@convohop/client/push#NotificationKind",
      "anchor": "notificationkind-type",
      "signatures": [
        "type NotificationKind = \"message\" | \"ring\" | \"stopRinging\" | \"missedCall\""
      ],
      "docs": "What to present for a push:\n- `message`: a new message.\n- `ring`: an incoming call that is still ringing.\n- `stopRinging`: the call stopped ringing without being missed: it was answered or declined, on any device, or\n  stopped for a reason this SDK doesn't know.\n- `missedCall`: nobody answered: the call ended first or the ring expired."
    },
