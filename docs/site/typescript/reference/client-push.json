    {
      "name": "NotificationHandler",
      "kind": "class",
      "ref": "@convohop/client/push#NotificationHandler",
      "anchor": "notificationhandler-class",
      "signatures": ["class NotificationHandler"],
      "docs": "Decides how to present pushes. It remembers recent events and stopped rings, so it recognizes duplicates and stops\na call whose cancellation arrived first. A service worker keeps this memory only while it runs.",
      "members": [
        {
          "name": "handle",
          "kind": "method",
          "ref": "@convohop/client/push#NotificationHandler.handle",
          "anchor": "notificationhandlerhandle-method",
          "signatures": ["handle(payload: unknown, now?: number): NotificationAction"],
          "docs": "Validates a push, recognizes duplicates by `eventId`, and treats a call as stopped once a cancellation of its ring\narrived (in either order) or its `expiresAt` passed. Throws a `TypeError` for a payload that isn't a valid\nnotification. `now` is in milliseconds."
        }
      ]
    },
