    {
      "name": "PushPayloadCode",
      "kind": "type",
      "ref": "convohop.push#PushPayloadCode",
      "anchor": "pushpayloadcode-type",
      "signatures": ["PushPayloadCode: TypeAlias = Literal[\"INVALID_EVENT\", \"INVALID_OPTIONS\"]"],
      "docs": "Why a push payload couldn't be built:\n\n- `INVALID_OPTIONS`: an option has the wrong type, `title` or `body` has a lone surrogate, `now` isn't a\n  timezone-aware datetime, or `bundle_id` isn't an app bundle ID. Options are checked first.\n- `INVALID_EVENT`: the event doesn't match the push payload contract."
    },
    {
      "name": "apns_alert",
      "kind": "function",
      "ref": "convohop.push#apns_alert",
      "anchor": "apns_alert-function",
      "signatures": [
        "def apns_alert(\n    event: WebhookNotificationEvent | Mapping[str, Any],\n    *,\n    bundle_id: str,\n    title: str | None = None,\n    body: str | None = None,\n    preview: bool = True,\n    now: datetime | None = None,\n) -> ApnsAlertRequest | None"
      ],
      "docs": "An APNs alert for a message, an incoming call, or a missed call (`notification.callCancelled` with reason\n`ended` or `expired`); `None` for other cancellations and stale events. At most 4096 bytes.\n\nParameters:\n\n- `event`: A notification event.\n- `bundle_id`: The app's bundle ID, the `apns-topic`.\n- `title`: The visible title, such as the sender's or conversation's name. Omitted when empty.\n- `body`: The visible body. Replaces the message preview. Omitted when empty.\n- `preview`: Whether a message event's preview becomes the body when `body` is empty.\n- `now`: The clock for the lifetime and expiration, a timezone-aware datetime. Defaults to the current time.\n\nRaises:\n\n- `PushPayloadError`: An option or the event is invalid."
    },
    {
      "name": "apns_voip",
      "kind": "function",
      "ref": "convohop.push#apns_voip",
      "anchor": "apns_voip-function",
      "signatures": [
        "def apns_voip(\n    event: WebhookNotificationEvent | Mapping[str, Any],\n    *,\n    bundle_id: str,\n    title: str | None = None,\n    body: str | None = None,\n    preview: bool = True,\n    now: datetime | None = None,\n) -> ApnsVoipRequest | None"
      ],
      "docs": "An APNs VoIP push for an incoming call; `None` for other events and stale calls. The topic is\n`<bundle_id>.voip`. iOS requires you to report every VoIP push to CallKit as a call. At most 5120 bytes.\n\nArguments and errors are as for `apns_alert()`."
    },
    {
      "name": "encode",
      "kind": "function",
      "ref": "convohop.push#encode",
      "anchor": "encode-function",
      "signatures": ["def encode(value: object) -> bytes"],
      "docs": "Serializes a request part as compact UTF-8 JSON, the form the builders measure. For example,\n`encode(request[\"payload\"])` is the APNs body and the Web Push plaintext."
    },
    {
      "name": "fcm",
      "kind": "function",
      "ref": "convohop.push#fcm",
      "anchor": "fcm-function",
      "signatures": [
        "def fcm(\n    event: WebhookNotificationEvent | Mapping[str, Any],\n    *,\n    title: str | None = None,\n    body: str | None = None,\n    preview: bool = True,\n    now: datetime | None = None,\n) -> FcmRequest | None"
      ],
      "docs": "An FCM data message for any notification event; `None` for stale events. At most 4096 bytes of `data` as\nJSON. Android apps build the notification themselves.\n\nArguments and errors are as for `apns_alert()`, without `bundle_id`."
    },
    {
      "name": "web_push",
      "kind": "function",
      "ref": "convohop.push#web_push",
      "anchor": "web_push-function",
      "signatures": [
        "def web_push(\n    event: WebhookNotificationEvent | Mapping[str, Any],\n    *,\n    title: str | None = None,\n    body: str | None = None,\n    preview: bool = True,\n    now: datetime | None = None,\n) -> WebPushRequest | None"
      ],
      "docs": "A Web Push message for any notification event; `None` for stale events. At most 3993 bytes, the RFC 8291\nplaintext limit. Your service worker shows the notification.\n\nArguments and errors are as for `apns_alert()`, without `bundle_id`."
    }
  ]
}
