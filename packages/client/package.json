{
  "name": "@convohop/client",
  "version": "0.1.0",
  "private": true,
  "description": "ConvoHop client SDK for browsers and React Native. Uses short-lived user session tokens for conversations, realtime and media.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ConvoHop/sdks.git",
    "directory": "packages/client"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "npm run build && node --test test/*.test.mjs",
    "check:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@convohop/core": "0.1.0",
    "livekit-client": "^2.22.3"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
