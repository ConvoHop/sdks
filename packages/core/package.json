{
  "name": "@convohop/core",
  "version": "0.1.0",
  "private": false,
  "description": "Shared ConvoHop protocol types, generated GraphQL operations and isomorphic transport. Installed as a dependency of @convohop/client and @convohop/server; not a supported entry point.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ConvoHop/sdks.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./internal/generated": {
      "types": "./dist/internal-generated.d.ts",
      "default": "./dist/internal-generated.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc --build",
    "test": "npm run build && node --test test/*.test.mjs",
    "check:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
