{
  "name": "@convohop/cli",
  "version": "0.0.0",
  "private": true,
  "description": "ConvoHop command-line interface for project operators: login, projects, backend keys, webhooks and push payload tests. Built on @convohop/server; runs only in trusted Node.js runtimes.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ConvoHop/sdks.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "sideEffects": [
    "./dist/bin.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "convohop": "dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "npm run build && node --test test/*.test.mjs",
    "check:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@convohop/server": "*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
